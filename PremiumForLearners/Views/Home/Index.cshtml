    AOS.init({
        duration: 1000,
        once: false,
        mirror: true,
        offset: 50,
        easing: 'ease-in-out'
    });

    // Smooth scrolling for anchor links
    document.querySelectorAll('a[href^="#"]').forEach(anchor => {
        anchor.addEventListener('click', function (e) {
            e.preventDefault();
            const target = document.querySelector(this.getAttribute('href'));
            if (target) {
                target.scrollIntoView({
                    behavior: 'smooth',
                    block: 'start'
                });
            }
        });
    });

    // Navbar background change on scroll
    window.addEventListener('scroll', function() {
        const navbar = document.querySelector('.navbar-modern');
        if (window.scrollY > 50) {
            navbar.style.background = 'linear-gradient(135deg, #0f2b5e, #1e3a8a)';
            navbar.style.boxShadow = '0 4px 30px rgba(0,0,0,0.2)';
        } else {
            navbar.style.background = 'linear-gradient(135deg, var(--primary-blue), var(--secondary-blue))';
            navbar.style.boxShadow = '0 4px 20px rgba(30, 58, 138, 0.2)';
        }
    });

    // Add loading animation
    window.addEventListener('load', function() {
        document.body.style.opacity = '1';
    });
</script>

<!-- Scripts -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/countup.js/2.8.0/countUp.umd.js"></script>

<script>

       // Initialize AOS with enhanced settings
    AOS.init({
        duration: 1000,           // Animation duration (ms)
        once: false,              // Animate every time you scroll
        mirror: true,             // Animate when scrolling back up
        offset: 50,               // Start offset before element enters viewport (px)
        easing: 'ease-out-cubic', // Smooth easing function
        delay: 0,                 // Default delay (overridden by data-aos-delay)
        disable: false,           // Never disable
        startEvent: 'DOMContentLoaded',
        initClassName: 'aos-init',
        animatedClassName: 'aos-animate',
        useClassNames: false,
        throttleDelay: 99,
        debounceDelay: 50
    });

    AOS.init({ duration: 1000, once: true });
    gsap.registerPlugin(ScrollTrigger);

    function animateTextWordByWord(elementId, triggerSelector, isMissionText = false) {
        const element = document.getElementById(elementId);
        if (!element) return;

        if (isMissionText) {
            const spans = element.querySelectorAll('span');
            const wordSpans = Array.from(spans);
            wordSpans.forEach(span => {
                span.style.opacity = '0';
                span.style.transform = 'translateY(30px)';
                span.style.display = 'inline-block';
                span.style.transition = 'all 0.6s cubic-bezier(0.2, 0.9, 0.4, 1.1)';
            });
            ScrollTrigger.create({
                trigger: triggerSelector,
                start: "top 80%",
                onEnter: () => {
                    wordSpans.forEach((span, i) => {
                        gsap.to(span, {
                            opacity: 1,
                            y: 0,
                            duration: 0.6,
                            delay: i * 0.12,
                            ease: "power2.out",
                            overwrite: true
                        });
                    });
                },
                once: true
            });
            return;
        }

        const text = element.innerText;
        const words = text.split(/\s+/);
        element.innerHTML = '';
        words.forEach((word, index) => {
            const span = document.createElement('span');
            span.className = 'word';
            span.innerText = word;
            span.style.opacity = '0';
            span.style.transform = 'translateY(30px)';
            span.style.display = 'inline-block';
            element.appendChild(span);
            if (index < words.length - 1) {
                element.appendChild(document.createTextNode(' '));
            }
        });
        const wordSpans = element.querySelectorAll('.word');
        ScrollTrigger.create({
            trigger: triggerSelector,
            start: "top 80%",
            onEnter: () => {
                wordSpans.forEach((span, i) => {
                    gsap.to(span, {
                        opacity: 1,
                        y: 0,
                        duration: 0.6,
                        delay: i * 0.12,
                        ease: "power2.out",
                        overwrite: true
                    });
                });
            },
            once: true
        });
    }

    animateTextWordByWord("heroHeading", ".hero");
    animateTextWordByWord("heroSubtitle", ".hero");
    animateTextWordByWord("featuresTitle", "#features");
    animateTextWordByWord("featuresSubtitle", "#features");
    animateTextWordByWord("howItWorksTitle", "#howitworks");
    animateTextWordByWord("howItWorksSubtitle", "#howitworks");
    animateTextWordByWord("ctaHeading", ".cta-section");
    animateTextWordByWord("ctaSubtitle", ".cta-section");
    animateTextWordByWord("footerLogo", ".footer");
    animateTextWordByWord("footerDesc", ".footer");
    animateTextWordByWord("footerNavTitle", ".footer");
    animateTextWordByWord("footerNav1", ".footer");
    animateTextWordByWord("footerNav2", ".footer");
    animateTextWordByWord("footerNav3", ".footer");
    animateTextWordByWord("footerResourcesTitle", ".footer");
    animateTextWordByWord("footerRes1", ".footer");
    animateTextWordByWord("footerRes2", ".footer");
    animateTextWordByWord("footerRes3", ".footer");
    animateTextWordByWord("footerContactTitle", ".footer");
    animateTextWordByWord("footerEmail", ".footer");
    animateTextWordByWord("footerSocial", ".footer");
    animateTextWordByWord("footerCopyright", ".footer");
    animateTextWordByWord("missionText", ".mission-section", true);

    function animateStats() {
        new countUp.CountUp('statSchools', 150).start();
        new countUp.CountUp('statStudents', 1250).start();
        new countUp.CountUp('statSubjects', 45).start();
        new countUp.CountUp('statParents', 890).start();
    }
    ScrollTrigger.create({ trigger: '.stats-section', start: 'top 80%', onEnter: animateStats, once: true });

    const cards = document.querySelectorAll('.stat-card-custom');
    const statsSection = document.getElementById('statsSection');
    if (cards.length > 0 && statsSection) {
        let animationStarted = false;
        ScrollTrigger.create({
            trigger: statsSection,
            start: "top 70%",
            onEnter: () => {
                if (!animationStarted) {
                    animationStarted = true;
                    cards.forEach((card, index) => {
                        setTimeout(() => {
                            card.classList.add('animate-in');
                        }, index * 500);
                    });
                }
            },
            once: true
        });
    }

     

    // Animate feature cards on scroll
    gsap.utils.toArray('.feature-card-large, .feature-card-medium, .feature-card-medium-small, .feature-card-small').forEach((card, i) => {
        gsap.from(card, {
            scrollTrigger: { trigger: card, start: 'top 75%', toggleActions: 'play none none reverse' },
            y: 40, opacity: 0, duration: 0.5, delay: i * 0.08, ease: 'power2.out'
        });
    });

    // ========== HOW IT WORKS SECTION - SLIDE IN ON SCROLL ==========
    const stepCards = document.querySelectorAll('.step-card-new');
    const howItWorksSection = document.getElementById('howitworks');

    if (stepCards.length > 0 && howItWorksSection) {
        let animationStarted = false;

        ScrollTrigger.create({
            trigger: howItWorksSection,
            start: "top 75%",
            onEnter: () => {
                if (!animationStarted) {
                    animationStarted = true;
                    stepCards.forEach((card, index) => {
                        setTimeout(() => {
                            card.classList.add('visible');
                        }, index * 150);
                    });
                }
            },
            once: true
        });
    }
</script>