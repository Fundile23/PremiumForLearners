@{
    ViewData["Title"] = "PremiumForLearners - Smart School Registration";
}

<!-- Bootstrap 5 CSS -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
<!-- Font Awesome 6 -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
<!-- Google Fonts -->
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:wght@400;500;600;700&display=swap" rel="stylesheet">
<!-- AOS Animation -->
<link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">

<style>
    :root {
        --black: #000000;
        --white: #ffffff;
        --gray-dark: #1a1a1a;
        --gray-medium: #2c2c2c;
        --gray-light: #3a3a3a;
        --gray-lighter: #f5f5f5;
        --gray-text: #6b6b6b;
        --gray-border: #333333;
        --sky-blue: #E8F4FD;
        --royal-blue: #1e3a8a;
        --royal-blue-light: #2563eb;
        --teal: #0f766e;
        --teal-light: #14b8a6;
    }

    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    body {
        font-family: 'Inter', sans-serif;
        background-color: var(--white);
        color: var(--gray-text);
        line-height: 1.6;
        overflow-x: hidden;
    }

    h1, h2, h3, h4, h5, h6 {
        font-family: 'Playfair Display', serif;
        color: var(--black);
    }

    /* Navigation */
    .navbar {
        background-color: var(--white) !important;
        box-shadow: 0 2px 20px rgba(0,0,0,0.05);
        padding: 15px 0;
        border-bottom: 1px solid #eee;
    }

    .navbar-brand {
        font-family: 'Playfair Display', serif;
        font-weight: 700;
        color: var(--black) !important;
        font-size: 1.8rem;
    }

    .nav-link {
        color: var(--gray-medium) !important;
        font-weight: 500;
        margin: 0 15px;
        transition: color 0.3s ease;
    }

        .nav-link:hover {
            color: var(--black) !important;
        }

    /* Buttons */
    .btn-primary-custom {
        background-color: var(--black);
        color: white;
        border: none;
        padding: 12px 30px;
        border-radius: 50px;
        font-weight: 500;
        transition: all 0.3s ease;
        text-decoration: none;
        display: inline-block;
    }

        .btn-primary-custom:hover {
            background-color: var(--gray-dark);
            transform: translateY(-3px);
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15);
            color: white;
        }

    .btn-outline-custom {
        background-color: transparent;
        border: 2px solid var(--black);
        color: var(--black);
        padding: 12px 30px;
        border-radius: 50px;
        font-weight: 500;
        transition: all 0.3s ease;
        text-decoration: none;
        display: inline-block;
    }

        .btn-outline-custom:hover {
            background-color: var(--black);
            color: white;
            transform: translateY(-3px);
        }

    /* Hero Section */
    .hero {
        padding: 20px 0 60px;
        background: var(--white);
        position: relative;
        overflow: hidden;
    }

        .hero::before {
            content: '';
            position: absolute;
            top: -50%;
            right: -10%;
            width: 600px;
            height: 600px;
            background: radial-gradient(circle, #f0f0f0 0%, transparent 70%);
            border-radius: 50%;
            opacity: 0.3;
        }

    .hero-content {
        position: relative;
        z-index: 2;
    }

    .hero h1 {
        font-size: 3.5rem;
        font-weight: 700;
        margin-bottom: 20px;
        line-height: 1.2;
    }

        .hero h1 .highlight {
            color: var(--black);
            position: relative;
            display: inline-block;
        }

        .hero h1 .light-text {
            color: var(--gray-text);
            font-weight: 500;
        }

    .hero .highlight::after {
        content: '';
        position: absolute;
        bottom: 5px;
        left: 0;
        width: 100%;
        height: 10px;
        background-color: #e0e0e0;
        opacity: 0.5;
        z-index: -1;
    }

    .hero-subtitle {
        font-size: 1.1rem;
        color: var(--gray-text);
        margin-bottom: 30px;
    }

    /* Hero Video Container */
    .hero-video-container {
        position: relative;
        width: 100%;
        max-width: 100%;
        border-radius: 30px;
        overflow: hidden;
        box-shadow: 0 30px 50px rgba(0,0,0,0.15);
        transition: all 0.4s ease;
        opacity: 0;
        transform: scale(0.95);
        animation: videoReveal 0.8s cubic-bezier(0.2, 0.9, 0.4, 1.1) forwards;
    }

        .hero-video-container:hover {
            transform: translateY(-8px) scale(1.02);
            box-shadow: 0 40px 60px rgba(0,0,0,0.2);
        }

    @@keyframes videoReveal {
        0% {
            opacity: 0;
            transform: scale(0.95);
        }

        100% {
            opacity: 1;
            transform: scale(1);
        }
    }

    .hero-video {
        width: 100%;
        height: auto;
        display: block;
    }

    /* Video Overlay Buttons */
    .video-buttons-overlay {
        position: absolute;
        top: 20px;
        left: 20px;
        z-index: 10;
        display: flex;
        flex-direction: column;
        gap: 12px;
        opacity: 0;
        animation: buttonsAppear 0.6s ease-out forwards;
        animation-delay: 0.4s;
    }

    @@keyframes buttonsAppear {
        0% {
            opacity: 0;
            transform: translateX(-10px);
        }

        100% {
            opacity: 1;
            transform: translateX(0);
        }
    }

    .prototype-row {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .stat-prototype-small {
        background: transparent;
        border: 1.5px solid rgba(255, 255, 255, 0.9);
        border-radius: 30px;
        padding: 6px 14px;
        backdrop-filter: blur(4px);
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

        .stat-prototype-small:hover {
            background: rgba(0, 0, 0, 0.2);
            border-color: white;
            transform: translateX(3px);
        }

        .stat-prototype-small .stat-text {
            color: white;
            font-size: 0.7rem;
            font-weight: 600;
            letter-spacing: 0.3px;
            text-shadow: 0 1px 2px rgba(0,0,0,0.2);
        }

        .stat-prototype-small .stat-number {
            color: white;
            font-size: 0.75rem;
            font-weight: 700;
            margin-left: 2px;
        }

    .plus-btn-small {
        width: 28px;
        height: 28px;
        background: white;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        transition: all 0.3s ease;
        box-shadow: 0 2px 6px rgba(0,0,0,0.2);
    }

        .plus-btn-small i {
            color: black;
            font-size: 0.9rem;
            font-weight: bold;
        }

        .plus-btn-small:hover {
            transform: scale(1.1);
            background: #f0f0f0;
        }

    .video-overlay {
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        background: linear-gradient(to top, rgba(0,0,0,0.85) 0%, transparent 100%);
        padding: 50px 25px 25px;
        text-align: center;
        opacity: 0;
        transform: translateY(20px);
        transition: all 0.5s cubic-bezier(0.2, 0.9, 0.4, 1.1);
    }

    .hero-video-container:hover .video-overlay {
        opacity: 1;
        transform: translateY(0);
    }

    .video-text {
        color: white;
        font-size: 1rem;
        font-weight: 500;
        line-height: 1.5;
        text-shadow: 0 2px 10px rgba(0,0,0,0.5);
        margin: 0;
        letter-spacing: 0.5px;
    }

        .video-text span {
            display: inline-block;
            font-size: 1.2rem;
            font-weight: 600;
            margin-bottom: 8px;
        }

    /* Mission Statement Section */
    .mission-section {
        padding: 40px 0 20px;
        background: var(--white);
        text-align: center;
    }

    .mission-text {
        max-width: 900px;
        margin: 0 auto;
        font-size: 1.2rem;
        line-height: 1.6;
    }

    .mission-keyword {
        color: var(--black);
        font-weight: 600;
    }

    .mission-light {
        color: var(--gray-text);
    }

    /* Stats Section */
    .stats-section {
        padding: 60px 0;
        background-color: var(--white);
    }

    .stat-card-custom {
        border-radius: 24px;
        padding: 28px 20px;
        height: 100%;
        transition: all 0.4s cubic-bezier(0.2, 0.9, 0.4, 1.1);
        position: relative;
        overflow: hidden;
        opacity: 0;
        transform: scale(0);
        transform-origin: center center;
    }

        .stat-card-custom.animate-in {
            animation: sequentialOpen 0.8s cubic-bezier(0.2, 0.9, 0.4, 1) forwards;
        }

    @@keyframes sequentialOpen {
        0% {
            opacity: 0;
            transform: scale(0);
        }

        40% {
            opacity: 0.3;
            transform: scale(0.6);
        }

        70% {
            opacity: 0.7;
            transform: scale(1.02);
        }

        100% {
            opacity: 1;
            transform: scale(1);
        }
    }

    .stat-card-custom .icon-wrapper,
    .stat-card-custom .stat-title,
    .stat-card-custom .stat-description,
    .stat-card-custom .stat-badge,
    .stat-card-custom .image-card-content {
        opacity: 0;
        animation: contentFadeIn 0.5s ease forwards;
    }

    .stat-card-custom .icon-wrapper {
        animation-delay: 0.4s;
    }

    .stat-card-custom .stat-title {
        animation-delay: 0.5s;
    }

    .stat-card-custom .stat-description {
        animation-delay: 0.6s;
    }

    .stat-card-custom .stat-badge {
        animation-delay: 0.7s;
    }

    .stat-card-custom .image-card-content {
        animation-delay: 0.5s;
    }

    @@keyframes contentFadeIn {
        0% {
            opacity: 0;
            transform: translateY(15px);
        }

        100% {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .stat-card-custom:hover {
        transform: translateY(-8px) scale(1.02);
        box-shadow: 0 20px 35px rgba(0,0,0,0.1);
    }

    .royal-blue {
        background: linear-gradient(135deg, var(--royal-blue) 0%, var(--royal-blue-light) 100%);
        color: white;
    }

        .royal-blue .icon-wrapper {
            width: 50px;
            height: 50px;
            background: rgba(255,255,255,0.2);
            border-radius: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 20px;
        }

            .royal-blue .icon-wrapper i {
                font-size: 1.8rem;
                color: white;
            }

    .stat-title {
        font-size: 1.3rem;
        font-weight: 700;
        margin-bottom: 12px;
        font-family: 'Inter', sans-serif;
    }

    .stat-description {
        font-size: 0.85rem;
        line-height: 1.5;
        margin-bottom: 20px;
        opacity: 0.9;
    }

    .stat-badge {
        display: inline-block;
        background: rgba(255,255,255,0.2);
        padding: 6px 12px;
        border-radius: 40px;
        font-size: 0.7rem;
        font-weight: 500;
    }

    .teal-bg {
        background: linear-gradient(135deg, var(--teal) 0%, var(--teal-light) 100%);
        color: white;
    }

        .teal-bg .icon-wrapper {
            width: 50px;
            height: 50px;
            background: rgba(255,255,255,0.2);
            border-radius: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 20px;
        }

            .teal-bg .icon-wrapper i {
                font-size: 1.8rem;
                color: white;
            }

    .stat-description.large {
        font-size: 0.9rem;
        line-height: 1.6;
    }

    .image-card {
        background-size: cover;
        background-position: center;
        position: relative;
        color: white;
        display: flex;
        align-items: flex-end;
    }

    .image-overlay-dark {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: linear-gradient(to top, rgba(0,0,0,0.7) 0%, rgba(0,0,0,0.2) 100%);
        border-radius: 24px;
    }

    .image-card-content {
        position: relative;
        z-index: 2;
        width: 100%;
    }

    .image-title {
        font-size: 1.3rem;
        font-weight: 700;
        margin-bottom: 8px;
        color: white;
        font-family: 'Inter', sans-serif;
    }

    .image-text {
        font-size: 0.8rem;
        opacity: 0.9;
        margin-bottom: 16px;
        line-height: 1.4;
    }

    .btn-white-outline {
        display: inline-block;
        background: transparent;
        border: 1.5px solid white;
        color: white;
        padding: 8px 20px;
        border-radius: 40px;
        font-size: 0.75rem;
        font-weight: 500;
        text-decoration: none;
        transition: all 0.3s ease;
    }

        .btn-white-outline:hover {
            background: white;
            color: black;
            transform: translateX(5px);
        }

    /* ========== FEATURES SECTION ========== */
    .feature-section {
        padding: 60px 0;
        background-color: var(--white);
    }

    .custom-features-layout {
        display: flex;
        gap: 30px;
        align-items: stretch;
    }

    /* LEFT SIDE - Easy Registration (Large but compact) */
    .feature-left-large {
        flex: 2;
    }

    .feature-card-large {
        background-size: cover;
        background-position: center;
        border-radius: 28px;
        padding: 32px 28px;
        border: 1px solid #e8e8e8;
        transition: all 0.4s cubic-bezier(0.2, 0.9, 0.4, 1.1);
        height: 100%;
        display: flex;
        flex-direction: column;
        position: relative;
        color: white;
    }

        .feature-card-large::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(135deg, rgba(0,0,0,0.65) 0%, rgba(0,0,0,0.35) 100%);
            border-radius: 28px;
            z-index: 0;
        }

        .feature-card-large > * {
            position: relative;
            z-index: 1;
        }

        .feature-card-large:hover {
            transform: translateY(-6px);
            border-color: var(--black);
            box-shadow: 0 15px 30px rgba(0,0,0,0.08);
        }

        .feature-card-large h3 {
            font-size: 1.6rem;
            font-weight: 700;
            color: white;
            margin-bottom: 12px;
            font-family: 'Playfair Display', serif;
        }

        .feature-card-large p {
            color: rgba(255,255,255,0.9);
            font-size: 0.85rem;
            line-height: 1.5;
            margin-bottom: 20px;
            flex: 1;
        }

        .feature-card-large .feature-link a {
            color: white;
            text-decoration: none;
            font-weight: 500;
            font-size: 0.85rem;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            transition: gap 0.3s ease;
            border-bottom: 1px solid rgba(255,255,255,0.5);
            padding-bottom: 2px;
        }

            .feature-card-large .feature-link a:hover {
                gap: 10px;
                border-bottom-color: white;
            }

    /* RIGHT SIDE */
    .feature-right-side {
        flex: 1.2;
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    /* School Transfers (Medium-Large) */
    .feature-card-medium {
        background-size: cover;
        background-position: center;
        border-radius: 24px;
        padding: 20px 22px;
        border: 1px solid #e8e8e8;
        transition: all 0.3s ease;
        position: relative;
        color: white;
    }

        .feature-card-medium::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(135deg, rgba(0,0,0,0.6) 0%, rgba(0,0,0,0.25) 100%);
            border-radius: 24px;
            z-index: 0;
        }

        .feature-card-medium > * {
            position: relative;
            z-index: 1;
        }

        .feature-card-medium:hover {
            transform: translateY(-4px);
            border-color: var(--black);
        }

        .feature-card-medium .feature-icon {
            width: 42px;
            height: 42px;
            background: rgba(255,255,255,0.2);
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 12px;
            backdrop-filter: blur(4px);
        }

            .feature-card-medium .feature-icon i {
                font-size: 1.1rem;
                color: white;
            }

        .feature-card-medium h4 {
            font-size: 1rem;
            font-weight: 700;
            color: white;
            margin-bottom: 6px;
            font-family: 'Inter', sans-serif;
        }

        .feature-card-medium p {
            font-size: 0.75rem;
            color: rgba(255,255,255,0.9);
            margin-bottom: 12px;
            line-height: 1.4;
        }

        .feature-card-medium .feature-link a {
            color: white;
            text-decoration: none;
            font-size: 0.7rem;
            font-weight: 500;
            display: inline-flex;
            align-items: center;
            gap: 5px;
            border-bottom: 1px solid rgba(255,255,255,0.5);
            padding-bottom: 2px;
        }

    /* Subject Selection (Medium) */
    .feature-card-medium-small {
        background-size: cover;
        background-position: center;
        border-radius: 24px;
        padding: 18px 20px;
        border: 1px solid #e8e8e8;
        transition: all 0.3s ease;
        position: relative;
        color: white;
    }

        .feature-card-medium-small::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(135deg, rgba(0,0,0,0.55) 0%, rgba(0,0,0,0.2) 100%);
            border-radius: 24px;
            z-index: 0;
        }

        .feature-card-medium-small > * {
            position: relative;
            z-index: 1;
        }

        .feature-card-medium-small:hover {
            transform: translateY(-3px);
            border-color: var(--black);
        }

        .feature-card-medium-small h4 {
            font-size: 0.95rem;
            font-weight: 700;
            color: white;
            margin-bottom: 6px;
        }

        .feature-card-medium-small p {
            font-size: 0.7rem;
            color: rgba(255,255,255,0.9);
            margin-bottom: 10px;
            line-height: 1.4;
        }

        .feature-card-medium-small .feature-link a {
            color: white;
            text-decoration: none;
            font-size: 0.65rem;
            font-weight: 500;
            display: inline-flex;
            align-items: center;
            gap: 5px;
            border-bottom: 1px solid rgba(255,255,255,0.5);
            padding-bottom: 2px;
        }

    /* Three Small Cards Row */
    .small-cards-row {
        display: flex;
        gap: 15px;
    }

    .feature-card-small {
        flex: 1;
        background-size: cover;
        background-position: center;
        border-radius: 20px;
        padding: 16px 12px;
        border: 1px solid #e8e8e8;
        transition: all 0.3s ease;
        text-align: center;
        position: relative;
        color: white;
    }

        .feature-card-small::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(135deg, rgba(0,0,0,0.5) 0%, rgba(0,0,0,0.15) 100%);
            border-radius: 20px;
            z-index: 0;
        }

        .feature-card-small > * {
            position: relative;
            z-index: 1;
        }

        .feature-card-small:hover {
            transform: translateY(-3px);
            border-color: var(--black);
        }

        .feature-card-small .feature-icon-small {
            width: 36px;
            height: 36px;
            background: rgba(255,255,255,0.2);
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 10px;
            backdrop-filter: blur(4px);
        }

            .feature-card-small .feature-icon-small i {
                font-size: 0.9rem;
                color: white;
            }

        .feature-card-small h5 {
            font-size: 0.8rem;
            font-weight: 700;
            color: white;
            margin-bottom: 4px;
            font-family: 'Inter', sans-serif;
        }

        .feature-card-small p {
            font-size: 0.6rem;
            color: rgba(255,255,255,0.9);
            margin-bottom: 8px;
            line-height: 1.3;
        }

        .feature-card-small .feature-link a {
            font-size: 0.6rem;
            font-weight: 500;
            color: white;
            text-decoration: none;
            border-bottom: 1px solid rgba(255,255,255,0.5);
            padding-bottom: 2px;
        }

    /* ========== HOW IT WORKS SECTION - FIXED ANIMATION ========== */
    .howitworks-section {
        padding: 80px 0;
        background-color: var(--white);
    }

    .steps-container {
        display: flex;
        gap: 24px;
        justify-content: center;
        flex-wrap: wrap;
    }

    .step-card-new {
        flex: 1;
        min-width: 240px;
        background-color: var(--sky-blue);
        border-radius: 28px;
        padding: 28px 24px;
        position: relative;
        overflow: hidden;
        transition: all 0.4s ease;
        box-shadow: 0 5px 15px rgba(0,0,0,0.02);
        border: 1px solid rgba(0,0,0,0.05);
        opacity: 0;
        transform: translateX(-40px);
        transition: all 0.6s cubic-bezier(0.2, 0.9, 0.4, 1.1);
    }

        .step-card-new.visible {
            opacity: 1;
            transform: translateX(0);
        }

        .step-card-new:hover {
            transform: translateY(-8px);
            box-shadow: 0 20px 35px rgba(0,0,0,0.08);
            border-color: var(--black);
        }

    /* Circle with Picture and Number at Top Left */
    .step-circle-wrapper {
        position: relative;
        margin-bottom: 20px;
    }

    .step-number-badge {
        position: absolute;
        top: -8px;
        left: -8px;
        width: 28px;
        height: 28px;
        background: var(--black);
        color: white;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.9rem;
        font-weight: 700;
        z-index: 2;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    }

    .step-circle {
        width: 80px;
        height: 80px;
        background: var(--white);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        box-shadow: 0 8px 20px rgba(0,0,0,0.05);
        border: 2px solid rgba(0,0,0,0.05);
        transition: all 0.4s ease;
        opacity: 0;
        transform: scale(0.8);
    }

    .step-card-new.visible .step-circle {
        opacity: 1;
        transform: scale(1);
        transition: all 0.5s cubic-bezier(0.2, 0.9, 0.4, 1.1) 0.1s;
    }

    .step-circle img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .step-circle i {
        font-size: 2.2rem;
        color: var(--gray-medium);
    }

    /* Step Content - Appears after circle */
    .step-content {
        opacity: 0;
        transform: translateY(20px);
        transition: all 0.5s cubic-bezier(0.2, 0.9, 0.4, 1.1);
    }

    .step-card-new.visible .step-content {
        opacity: 1;
        transform: translateY(0);
        transition-delay: 0.3s;
    }

    .step-content h4 {
        font-size: 1.2rem;
        font-weight: 700;
        color: var(--black);
        margin-bottom: 12px;
        font-family: 'Inter', sans-serif;
    }

    .step-content p {
        font-size: 0.85rem;
        color: var(--gray-medium);
        line-height: 1.5;
        margin: 0;
    }

    /* Individual delays for staggered appearance */
    .step-card-new:nth-child(1).visible .step-circle {
        transition-delay: 0s;
    }

    .step-card-new:nth-child(1).visible .step-content {
        transition-delay: 0.25s;
    }

    .step-card-new:nth-child(2).visible .step-circle {
        transition-delay: 0.1s;
    }

    .step-card-new:nth-child(2).visible .step-content {
        transition-delay: 0.35s;
    }

    .step-card-new:nth-child(3).visible .step-circle {
        transition-delay: 0.2s;
    }

    .step-card-new:nth-child(3).visible .step-content {
        transition-delay: 0.45s;
    }

    .step-card-new:nth-child(4).visible .step-circle {
        transition-delay: 0.3s;
    }

    .step-card-new:nth-child(4).visible .step-content {
        transition-delay: 0.55s;
    }

    @@media (max-width: 992px) {
        .custom-features-layout {
            flex-direction: column;
        }

        .small-cards-row {
            flex-wrap: wrap;
        }

        .feature-card-small {
            min-width: calc(33.33% - 10px);
        }

        .steps-container {
            flex-direction: column;
            align-items: center;
        }

        .step-card-new {
