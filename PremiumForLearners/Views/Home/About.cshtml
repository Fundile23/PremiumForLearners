@{
    ViewData["Title"] = "About";
}

<div class="container" style="padding: 80px 0;">
    <div class="row">
        <div class="col-lg-8 mx-auto text-center" data-aos="fade-up">
            <h1 class="mb-4">About PremiumForLearners</h1>
            <p class="lead" style="color: var(--brown-medium);">Making school registration and management accessible for every parent.</p>
            <div style="height: 4px; width: 80px; background: var(--brown-soft); margin: 30px auto;"></div>
        </div>
    </div>

    <div class="row mt-5">
        <div class="col-md-6" data-aos="fade-right">
            <h3>Our Mission</h3>
            <p>To eliminate the hassle of paper-based school registrations and create a seamless digital experience for parents, students, and schools.</p>

            <h3 class="mt-4">What We Offer</h3>
            <ul class="list-unstyled">
                <li class="mb-3"><i class="fas fa-check-circle me-2" style="color: var(--brown-soft);"></i> Online registration from home</li>
                <li class="mb-3"><i class="fas fa-check-circle me-2" style="color: var(--brown-soft);"></i> Subject selection for Grade 10-12</li>
                <li class="mb-3"><i class="fas fa-check-circle me-2" style="color: var(--brown-soft);"></i> School transfer requests</li>
                <li class="mb-3"><i class="fas fa-check-circle me-2" style="color: var(--brown-soft);"></i> Automatic academic history tracking</li>
                <li class="mb-3"><i class="fas fa-check-circle me-2" style="color: var(--brown-soft);"></i> Document vault for important files</li>
            </ul>
        </div>
        <div class="col-md-6" data-aos="fade-left">
            <div class="card p-4">
                <h4>For Schools</h4>
                <p>Administrators can review applications, verify documents, approve subject selections, and manage transfer requests - all in one dashboard.</p>
                <hr>
                <h4>For Parents</h4>
                <p>Track application status, upload documents, select subjects, request transfers, and communicate with schools - all from your phone.</p>
            </div>
        </div>
    </div>
</div>