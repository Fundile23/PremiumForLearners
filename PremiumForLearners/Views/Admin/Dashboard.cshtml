@model List<PremiumForLearners.Models.Student>

@{
    ViewData["Title"] = "Admin Dashboard - PremiumForLearners";
}

<!-- Bootstrap 5 CSS -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
<!-- Font Awesome 6 -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
<!-- Google Fonts -->
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:wght@400;500;600;700&display=swap" rel="stylesheet">
<!-- AOS Animation -->
<link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">

<style>
    :root {
        --black: #000000;
        --white: #ffffff;
        --gray-dark: #1a1a1a;
        --gray-medium: #2c2c2c;
        --gray-light: #3a3a3a;
        --gray-lighter: #f5f5f5;
        --gray-text: #6b6b6b;
        --gray-border: #333333;
        --sky-blue: #E8F4FD;
        --royal-blue: #1e3a8a;
        --royal-blue-light: #2563eb;
        --teal: #0f766e;
        --teal-light: #14b8a6;
        --success-green: #28a745;
        --warning-orange: #fd7e14;
        --danger-red: #dc3545;
        --info-blue: #17a2b8;
    }

    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    body {
        font-family: 'Inter', sans-serif;
        background-color: var(--white);
        color: var(--gray-text);
        line-height: 1.6;
        overflow-x: hidden;
    }

    h1, h2, h3, h4, h5, h6 {
        font-family: 'Playfair Display', serif;
        color: var(--black);
    }

    /* Admin Navigation */
    .navbar {
        background-color: var(--white) !important;
        box-shadow: 0 2px 20px rgba(0,0,0,0.05);
        padding: 15px 0;
        border-bottom: 1px solid #eee;
    }

    .navbar-brand {
        font-family: 'Playfair Display', serif;
        font-weight: 700;
        color: var(--black) !important;
        font-size: 1.8rem;
    }

    .nav-link {
        color: var(--gray-medium) !important;
        font-weight: 500;
        margin: 0 15px;
        transition: color 0.3s ease;
    }

        .nav-link:hover {
            color: var(--black) !important;
        }

    /* Admin Hero Section */
    .admin-hero {
        padding: 40px 0 30px;
        background: linear-gradient(135deg, var(--gray-lighter) 0%, var(--white) 100%);
        position: relative;
        overflow: hidden;
        margin-bottom: 40px;
    }

        .admin-hero::before {
            content: '';
            position: absolute;
            top: -50%;
            right: -10%;
            width: 500px;
            height: 500px;
            background: radial-gradient(circle, #e0e0e0 0%, transparent 70%);
            border-radius: 50%;
            opacity: 0.3;
        }

    .admin-hero-content {
        position: relative;
        z-index: 2;
    }

    .admin-hero h1 {
        font-size: 2.5rem;
        font-weight: 700;
        margin-bottom: 10px;
    }

    .admin-badge {
        display: inline-block;
        padding: 4px 12px;
        background: var(--black);
        color: white;
        border-radius: 40px;
        font-size: 0.75rem;
        font-weight: 500;
        margin-bottom: 15px;
    }

    /* Stats Cards */
    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 20px;
        margin-bottom: 40px;
    }

    .stat-card-admin {
        background: var(--white);
        border-radius: 24px;
        padding: 24px 20px;
        box-shadow: 0 5px 20px rgba(0,0,0,0.03);
        border: 1px solid #e8e8e8;
        transition: all 0.3s cubic-bezier(0.2, 0.9, 0.4, 1.1);
        position: relative;
        overflow: hidden;
    }

        .stat-card-admin:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 30px rgba(0,0,0,0.08);
            border-color: var(--black);
        }

    .stat-icon-admin {
        width: 50px;
        height: 50px;
        background: var(--gray-lighter);
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 16px;
    }

        .stat-icon-admin i {
            font-size: 1.5rem;
            color: var(--black);
        }

    .stat-number-admin {
        font-size: 2rem;
        font-weight: 800;
        color: var(--black);
        margin-bottom: 5px;
    }

    .stat-label-admin {
        color: var(--gray-text);
        font-size: 0.85rem;
    }

    /* Quick Actions */
    .quick-actions {
        display: flex;
        gap: 15px;
        flex-wrap: wrap;
        margin-bottom: 40px;
    }

    .action-btn {
        background: var(--gray-lighter);
        border: 1px solid #e0e0e0;
        border-radius: 50px;
        padding: 12px 24px;
        text-decoration: none;
        color: var(--black);
        font-weight: 500;
        font-size: 0.9rem;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

        .action-btn:hover {
            background: var(--black);
            color: white;
            transform: translateY(-2px);
            border-color: var(--black);
        }

    /* Tables */
    .card-modern {
        background: var(--white);
        border-radius: 24px;
        border: 1px solid #e8e8e8;
        overflow: hidden;
        margin-bottom: 30px;
        transition: all 0.3s ease;
    }

        .card-modern:hover {
            box-shadow: 0 10px 30px rgba(0,0,0,0.05);
        }

    .card-header-modern {
        background: var(--gray-lighter);
        padding: 20px 24px;
        border-bottom: 1px solid #e0e0e0;
    }

        .card-header-modern h5 {
            margin: 0;
            font-size: 1.1rem;
            font-weight: 600;
        }

    .table-custom {
        margin: 0;
    }

        .table-custom th {
            background: var(--white);
            color: var(--black);
            font-weight: 600;
            border-bottom: 1px solid #e8e8e8;
            padding: 15px 20px;
        }

        .table-custom td {
            padding: 15px 20px;
            vertical-align: middle;
            border-bottom: 1px solid #f0f0f0;
        }

        .table-custom tr:hover {
            background: var(--gray-lighter);
        }

    .status-badge {
        display: inline-block;
        padding: 4px 12px;
        border-radius: 40px;
        font-size: 0.7rem;
        font-weight: 600;
    }

    .status-submitted {
        background: #fff3cd;
        color: #856404;
    }

    .status-approved {
        background: #d4edda;
        color: #155724;
    }

    .status-enrolled {
        background: #cce5ff;
        color: #004085;
    }

    .status-rejected {
        background: #f8d7da;
        color: #721c24;
    }

    .status-pending {
        background: #fff3cd;
        color: #856404;
    }

    /* Footer */
    .footer {
        background-color: var(--black);
        color: var(--white);
        padding: 40px 0 30px;
        margin-top: 60px;
    }

        .footer a {
            color: #a0a0a0;
            text-decoration: none;
        }

            .footer a:hover {
                color: var(--white);
            }

    /* Responsive */
    @@media (max-width: 768px) {
        .stats-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .admin-hero h1 {
            font-size: 1.8rem;
        }

        .table-custom {
            font-size: 0.85rem;
        }

            .table-custom th, .table-custom td {
                padding: 10px 12px;
            }
    }
</style>

<!-- Navigation -->
<nav class="navbar navbar-expand-lg fixed-top">
    <div class="container">
        <a class="navbar-brand" href="/">PremiumForLearners</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav ms-auto">
                <li class="nav-item"><a class="nav-link" href="/Admin/Dashboard">Dashboard</a></li>
                <li class="nav-item"><a class="nav-link" href="/Admin/Applications">Applications</a></li>
                <li class="nav-item"><a class="nav-link" href="/Admin/VerifyPayments">Payments</a></li>
                <li class="nav-item"><a class="nav-link" href="/Admin/Announcements">Announcements</a></li>
                <li class="nav-item"><a class="nav-link" href="/Account/Logout">Logout</a></li>
            </ul>
        </div>
    </div>
</nav>

<!-- Admin Hero Section -->
<section class="admin-hero">
    <div class="container">
        <div class="admin-hero-content" data-aos="fade-up">
            <div class="admin-badge">Admin Portal</div>
            <h1>Welcome back, @User.Identity?.Name</h1>
            <p class="text-muted">Manage applications, verify payments, and communicate with parents</p>
        </div>
    </div>
</section>

<div class="container">
    <!-- Stats Cards -->
    <div class="stats-grid" data-aos="fade-up">
        <div class="stat-card-admin">
            <div class="stat-icon-admin"><i class="fas fa-file-alt"></i></div>
            <div class="stat-number-admin">@ViewBag.TotalApplications</div>
            <div class="stat-label-admin">Total Applications</div>
        </div>
        <div class="stat-card-admin">
            <div class="stat-icon-admin"><i class="fas fa-clock"></i></div>
            <div class="stat-number-admin text-warning">@ViewBag.PendingApplications</div>
            <div class="stat-label-admin">Pending Review</div>
        </div>
        <div class="stat-card-admin">
            <div class="stat-icon-admin"><i class="fas fa-check-circle"></i></div>
            <div class="stat-number-admin text-success">@ViewBag.ApprovedApplications</div>
            <div class="stat-label-admin">Approved</div>
        </div>
        <div class="stat-card-admin">
            <div class="stat-icon-admin"><i class="fas fa-users"></i></div>
            <div class="stat-number-admin">@ViewBag.EnrolledStudents</div>
            <div class="stat-label-admin">Enrolled Students</div>
        </div>
        <div class="stat-card-admin">
            <div class="stat-icon-admin"><i class="fas fa-exchange-alt"></i></div>
            <div class="stat-number-admin">@ViewBag.PendingTransfers</div>
            <div class="stat-label-admin">Pending Transfers</div>
        </div>
        <div class="stat-card-admin">
            <div class="stat-icon-admin"><i class="fas fa-credit-card"></i></div>
            <div class="stat-number-admin text-warning">@ViewBag.PendingPayments</div>
            <div class="stat-label-admin">Pending Payments</div>
        </div>
    </div>

    <!-- Quick Actions - REMOVED Subject Selections button -->
    <div class="quick-actions" data-aos="fade-up" data-aos-delay="100">
        <a href="/Admin/Applications?status=Submitted" class="action-btn"><i class="fas fa-file-alt"></i> Review Applications</a>
        <a href="/Admin/VerifyPayments" class="action-btn"><i class="fas fa-credit-card"></i> Verify Payments</a>
        <a href="/Admin/Transfers" class="action-btn"><i class="fas fa-exchange-alt"></i> Manage Transfers</a>
        <a href="/Admin/CreateAnnouncement" class="action-btn"><i class="fas fa-bullhorn"></i> Send Announcement</a>
    </div>

    <!-- Recent Applications -->
    <div class="card-modern" data-aos="fade-up" data-aos-delay="200">
        <div class="card-header-modern d-flex justify-content-between align-items-center">
            <h5><i class="fas fa-clock me-2"></i>Recent Applications</h5>
            <a href="/Admin/Applications" class="btn btn-sm btn-outline-primary">View All →</a>
        </div>
        <div class="table-responsive">
            <table class="table table-custom">
                <thead>
                    <tr>
                        <th>Student</th>
                        <th>Grade</th>
                        <th>Parent</th>
                        <th>Submitted</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var app in Model)
                        {
                            <tr>
                                <td><strong>@app.FullName</strong></td>
                                <td>Grade @app.ApplyingGrade</td>
                                <td>@app.Parent?.FullName</td>
                                <td>@(app.SubmittedAt?.ToString("dd MMM yyyy") ?? "-")</td>
                                <td>
                                    <span class="status-badge status-@(app.ApplicationStatus.ToLower())">
                                        @app.ApplicationStatus
                                    </span>
                                </td>
                                <td>
                                    <a href="/Admin/ReviewApplication/@app.Id" class="btn btn-sm btn-primary" style="padding: 5px 12px; font-size: 0.75rem;">
                                        Review
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted">No recent applications</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Pending Payments Section -->
    <div class="card-modern" data-aos="fade-up" data-aos-delay="300">
        <div class="card-header-modern d-flex justify-content-between align-items-center">
            <h5><i class="fas fa-credit-card me-2"></i>Pending Payments</h5>
            <a href="/Admin/VerifyPayments" class="btn btn-sm btn-outline-primary">Verify →</a>
        </div>
        <div class="table-responsive">
            <table class="table table-custom">
                <thead>
                    <tr>
                        <th>Student</th>
                        <th>Payment Type</th>
                        <th>Amount</th>
                        <th>Date</th>
                        <th>Reference</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (ViewBag.PendingPaymentsList != null && ViewBag.PendingPaymentsList.Count > 0)
                    {
                        @foreach (var payment in ViewBag.PendingPaymentsList)
                        {
                            <tr>
                                <td><strong>@payment.Student?.FullName</strong></td>
                                <td>@payment.PaymentType</td>
                                <td class="fw-bold">R @payment.Amount.ToString("N2")</td>
                                <td>@payment.PaymentDate.ToString("dd MMM yyyy")</td>
                                <td><small>@payment.Reference</small></td>
                                <td>
                                    <a href="/Admin/VerifyPayments" class="btn btn-sm btn-success" style="padding: 5px 12px; font-size: 0.75rem;">
                                        Verify
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted">No pending payments</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Footer -->
<footer class="footer">
    <div class="container">
        <div class="text-center">
            <p>&copy; @DateTime.Now.Year PremiumForLearners. All rights reserved.</p>
        </div>
    </div>
</footer>

<!-- Scripts -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
<script>
    AOS.init({ duration: 1000, once: true });
</script>