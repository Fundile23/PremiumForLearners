@model List<PremiumForLearners.Models.SubjectSelection>

@{
    ViewData["Title"] = "Subject Selections";
}

<div class="container">
    <h2 class="mb-4">Subject Selections (Grade 10-12 Only)</h2>

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center py-5">
            <i class="fas fa-info-circle fa-3x mb-3"></i>
            <h4>No pending subject selections</h4>
            <p>Subject selections are only available for students in Grades 10, 11, and 12.</p>
        </div>
    }
    else
    {
        <div class="card p-4">
            <div class="table-responsive">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Student</th>
                            <th>Grade</th>
                            <th>Electives</th>
                            <th>Submitted</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var selection in Model)
                        {
                            <tr>
                                <td>@selection.Student?.FullName</td>
                                <td>@selection.Grade</td>
                                <td>
                                    @selection.Elective1<br />
                                    @selection.Elective2<br />
                                    @selection.Elective3
                                </td>
                                <td>@selection.SelectionDate.ToString("dd MMM yyyy")</td>
                                <td>
                                    <form asp-action="ApproveSubjectSelection" method="post">
                                        <input type="hidden" name="selectionId" value="@selection.Id" />
                                        <button type="submit" class="btn btn-sm btn-success">Approve</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>