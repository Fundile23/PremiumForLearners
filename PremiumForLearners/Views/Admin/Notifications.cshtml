@model List<PremiumForLearners.Models.Notification>

@{
    ViewData["Title"] = "Admin Notifications";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1><i class="fas fa-bell me-2"></i>Notifications</h1>
        <span class="badge bg-danger p-2">@Model.Count(n => !n.IsRead) new</span>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center py-5">
            <i class="fas fa-bell-slash fa-3x mb-3 d-block"></i>
            <h4>No notifications</h4>
            <p>You're all caught up!</p>
        </div>
    }
    else
    {
        <div class="list-group">
            @foreach (var notif in Model.OrderByDescending(n => n.CreatedAt))
            {
                <div class="list-group-item @(notif.IsRead ? "" : "list-group-item-warning")">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="fw-bold">
                                @if (notif.NotificationType == "Warning")
                                {
                                    <i class="fas fa-exclamation-triangle text-danger me-2"></i>
                                }
                                else if (notif.NotificationType == "Success")
                                {
                                    <i class="fas fa-check-circle text-success me-2"></i>
                                }
                                else
                                {
                                    <i class="fas fa-info-circle text-info me-2"></i>
                                }
                                @notif.Title
                            </div>
                            <small class="text-muted">@notif.CreatedAt.ToString("dd MMM yyyy, HH:mm")</small>
                            <p class="mb-0 mt-2">@notif.Message</p>
                        </div>
                        <div>
                            @if (!string.IsNullOrEmpty(notif.Link))
                            {
                                <a href="@notif.Link" class="btn btn-sm btn-dark">View</a>
                            }
                            @if (!notif.IsRead)
                            {
                                <button class="btn btn-sm btn-outline-secondary ms-2 mark-read" data-id="@notif.Id">
                                    <i class="fas fa-check"></i> Mark read
                                </button>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<script>
    document.querySelectorAll('.mark-read').forEach(btn => {
        btn.addEventListener('click', async function() {
            const id = this.getAttribute('data-id');
            await fetch(`/Admin/MarkNotificationRead?id=${id}`, { method: 'POST' });
            this.closest('.list-group-item').classList.remove('list-group-item-warning');
            this.remove();
        });
    });
</script>