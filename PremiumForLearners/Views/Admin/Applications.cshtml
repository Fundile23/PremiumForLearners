@model List<PremiumForLearners.Models.Student>

@{
    ViewData["Title"] = "Applications";
    var currentStatus = ViewBag.CurrentStatus as string ?? "Submitted";
}

<div class="container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Applications</h2>
        <div class="btn-group">
            <a href="/Admin/Applications?status=Submitted" class="btn @(currentStatus == "Submitted" ? "btn-primary" : "btn-outline-primary")">Pending</a>
            <a href="/Admin/Applications?status=Approved" class="btn @(currentStatus == "Approved" ? "btn-success" : "btn-outline-success")">Approved</a>
            <a href="/Admin/Applications?status=Rejected" class="btn @(currentStatus == "Rejected" ? "btn-danger" : "btn-outline-danger")">Rejected</a>
        </div>
    </div>

    <div class="card p-4">
        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Student</th>
                            <th>Grade</th>
                            <th>Parent</th>
                            <th>Contact</th>
                            <th>Submitted</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var app in Model)
                        {
                            <tr>
                                <td>@app.FullName</td>
                                <td>@app.ApplyingGrade</td>
                                <td>@app.Parent?.FullName</td>
                                <td>@app.Parent?.PhoneNumber</td>
                                <td>@(app.SubmittedAt?.ToString("dd MMM yyyy") ?? "-")</td>
                                <td>
                                    <a href="/Admin/ReviewApplication/@app.Id" class="btn btn-sm btn-primary">Review</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <p class="text-muted">No @currentStatus.ToLower() applications found.</p>
        }
    </div>
</div>