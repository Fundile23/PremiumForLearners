@model PremiumForLearners.Models.Student

@{
    ViewData["Title"] = $"Review - {Model.FullName}";
    // Check if student is in Grade 10-12
    bool isHighSchool = int.TryParse(Model.ApplyingGrade, out int gradeNum) && gradeNum >= 10 && gradeNum <= 12;
}

<div class="container">
    <div class="mb-3">
        <a href="/Admin/Applications" class="btn btn-outline-secondary">← Back to Applications</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-triangle me-2"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row">
        <!-- Left Column - Student & Parent Info -->
        <div class="col-md-4 mb-4">
            <!-- Student Information Card -->
            <div class="card p-4 mb-4">
                <h5 class="mb-3"><i class="fas fa-user-graduate me-2"></i>Student Information</h5>
                <table class="table table-sm table-borderless">
                    <tr><th>Name:</th><td><strong>@Model.FullName</strong><\/td></tr>
                    <tr><th>Grade:</th><td>Grade @Model.ApplyingGrade<\/td></tr>
                    <tr><th>Date of Birth:</th><td>@Model.DateOfBirth.ToString("dd MMM yyyy")<\/td></tr>
                    <tr><th>Birth Cert #:</th><td>@Model.BirthCertificateNumber<\/td></tr>
                    <tr><th>Previous School:</th><td>@(Model.PreviousSchool ?? "None")<\/td></tr>
                </table>
                <hr>
                <div class="mt-2">
                    <p class="mb-1"><strong>Verification Status:</strong></p>
                    <div class="d-flex justify-content-between mb-1">
                        <span>📄 Documents:</span>
                        <span class="badge @(Model.DocumentsVerified ? "bg-success" : "bg-warning")">
                            @(Model.DocumentsVerified ? "Verified ✓" : "Pending")
                        </span>
                    </div>
                    @if (isHighSchool)
                    {
                        <div class="d-flex justify-content-between mb-1">
                            <span>📚 Subjects:</span>
                            <span class="badge @(Model.SubjectsVerified ? "bg-success" : "bg-warning")">
                                @(Model.SubjectsVerified ? "Verified ✓" : "Pending")
                            </span>
                        </div>
                    }
                    <div class="d-flex justify-content-between">
                        <span>💰 Payment:</span>
                        <span class="badge @(Model.PaymentVerified ? "bg-success" : "bg-warning")">
                            @(Model.PaymentVerified ? "Verified ✓" : "Pending")
                        </span>
                    </div>
                </div>
            </div>

            <!-- Parent Information Card -->
            <div class="card p-4">
                <h5 class="mb-3"><i class="fas fa-parent me-2"></i>Parent Information</h5>
                <table class="table table-sm table-borderless">
                    <tr><th>Name:</th><td><strong>@Model.Parent?.FullName</strong><\/td></tr>
                    <tr><th>Email:</th><td>@Model.Parent?.Email<\/td></tr>
                    <tr><th>Phone:</th><td>@Model.Parent?.PhoneNumber<\/td></tr>
                    <tr><th>Address:</th><td>@Model.Parent?.Address<\/td></tr>
                </table>
            </div>
        </div>

        <!-- Right Column - Documents, Subjects, Payment -->
        <div class="col-md-8 mb-4">
            <!-- Documents Section -->
            <div class="card p-4 mb-4">
                <h5 class="mb-3"><i class="fas fa-file-alt me-2"></i>Documents</h5>
                @if (Model.Documents.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Document Type</th>
                                    <th>File Name</th>
                                    <th>Status</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var doc in Model.Documents)
                                {
                                    <tr>
                                        <td>@doc.DocumentType</td>
                                        <td><small>@doc.FileName</small></td>
                                        <td>
                                            <span class="badge @(doc.VerificationStatus == "Verified" ? "bg-success" : "bg-warning")">
                                                @doc.VerificationStatus
                                            </span>
                                         </td>
                                        <td>
                                            <div class="btn-group btn-group-sm">
                                                <a href="/Admin/ViewDocument/@doc.Id" target="_blank" class="btn btn-outline-primary">
                                                    <i class="fas fa-eye"></i> View
                                                </a>
                                                @if (doc.VerificationStatus != "Verified")
                                                {
                                                    <form asp-action="VerifySingleDocument" asp-controller="Admin" method="post" style="display: inline;">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="documentId" value="@doc.Id" />
                                                        <input type="hidden" name="studentId" value="@Model.Id" />
                                                        <button type="submit" class="btn btn-outline-success">
                                                            <i class="fas fa-check"></i> Verify
                                                        </button>
                                                    </form>
                                                }
                                            </div>
                                         </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <form asp-action="VerifyDocument" asp-controller="Admin" method="post" class="mt-3">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <button type="submit" class="btn btn-success" @(Model.DocumentsVerified ? "disabled" : "")>
                            <i class="fas fa-check-circle me-2"></i> Verify All Documents
                        </button>
                    </form>
                }
                else
                {
                    <p class="text-muted">No documents uploaded yet.</p>
                }
            </div>

            <!-- Subject Selection Section - ONLY for Grades 10-12 -->
            @if (isHighSchool)
            {
                <div class="card p-4 mb-4">
                    <h5 class="mb-3"><i class="fas fa-book me-2"></i>Subject Selection</h5>
                    @if (Model.SubjectSelections.Any())
                    {
                        var selection = Model.SubjectSelections.OrderByDescending(s => s.SelectionDate).First();
                        <p><strong>Core Subjects:</strong> @selection.CoreSubjects</p>
                        <p><strong>Elective Subjects:</strong></p>
                        <ul>
                            @if (!string.IsNullOrEmpty(selection.Elective1))
                            {
                                <li>@selection.Elective1</li>
                            }
                            @if (!string.IsNullOrEmpty(selection.Elective2))
                            {
                                <li>@selection.Elective2</li>
                            }
                            @if (!string.IsNullOrEmpty(selection.Elective3))
                            {
                                <li>@selection.Elective3</li>
                            }
                            @if (!string.IsNullOrEmpty(selection.Elective4))
                            {
                                <li>@selection.Elective4</li>
                            }
                        </ul>
                        <p>
                            <strong>Status:</strong>
                            <span class="badge @(selection.Status == "Approved" ? "bg-success" : "bg-warning")">
                                @selection.Status
                            </span>
                        </p>
                        <p><small class="text-muted">Submitted: @selection.SelectionDate.ToString("dd MMM yyyy")</small></p>

                        @if (selection.Status != "Approved")
                        {
                            <form asp-action="VerifySubject" asp-controller="Admin" method="post" class="mt-3">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@Model.Id" />
                                <button type="submit" class="btn btn-success" @(Model.SubjectsVerified ? "disabled" : "")>
                                    <i class="fas fa-check-circle me-2"></i> Approve Subjects
                                </button>
                            </form>
                        }
                    }
                    else
                    {
                        <p class="text-muted">No subject selection submitted yet.</p>
                    }
                </div>
            }

            <!-- Payment Section -->
            <div class="card p-4 mb-4">
                <h5 class="mb-3"><i class="fas fa-credit-card me-2"></i>Payment Status</h5>
                <p>
                    <strong>Registration Fee Status:</strong>
                    <span class="badge @(Model.PaymentVerified ? "bg-success" : "bg-warning")">
                        @(Model.PaymentVerified ? "Paid ✓" : "Pending")
                    </span>
                </p>

                @if (!Model.PaymentVerified)
                {
                    <form asp-action="VerifyPayment" asp-controller="Admin" method="post" class="mt-3">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <button type="submit" class="btn btn-success">
                            <i class="fas fa-check-circle me-2"></i> Verify Payment
                        </button>
                    </form>
                }
            </div>

            <!-- Decision Buttons -->
            @if (Model.ApplicationStatus != "Approved" && Model.ApplicationStatus != "Rejected" && Model.ApplicationStatus != "Enrolled")
            {
                <div class="card p-4">
                    <h5 class="mb-3"><i class="fas fa-gavel me-2"></i>Application Decision</h5>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <form asp-action="ApproveApplication" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="studentId" value="@Model.Id" />
                                <button type="submit" class="btn btn-success w-100" onclick="return confirm('Approve this application?')">
                                    <i class="fas fa-check me-2"></i> Approve Application
                                </button>
                            </form>
                        </div>
                        <div class="col-md-6">
                            <button type="button" class="btn btn-danger w-100" data-bs-toggle="modal" data-bs-target="#rejectModal">
                                <i class="fas fa-times me-2"></i> Reject Application
                            </button>
                        </div>
                    </div>
                </div>
            }
            else if (Model.ApplicationStatus == "Approved")
            {
                <div class="alert alert-success text-center">
                    <i class="fas fa-check-circle me-2"></i> Application has been <strong>Approved</strong>
                </div>
            }
            else if (Model.ApplicationStatus == "Rejected")
            {
                <div class="alert alert-danger text-center">
                    <i class="fas fa-times-circle me-2"></i> Application has been <strong>Rejected</strong>
                </div>
            }
            else if (Model.ApplicationStatus == "Enrolled")
            {
                <div class="alert alert-info text-center">
                    <i class="fas fa-graduation-cap me-2"></i> Student has been <strong>Enrolled</strong>
                </div>
            }
        </div>
    </div>
</div>

<!-- Reject Modal -->
<div class="modal fade" id="rejectModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title"><i class="fas fa-exclamation-triangle me-2"></i>Reject Application</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="RejectApplication" method="post">
                <div class="modal-body">
                    <input type="hidden" name="studentId" value="@Model.Id" />
                    <div class="mb-3">
                        <label class="form-label fw-bold">Reason for Rejection</label>
                        <textarea name="rejectionReason" class="form-control" rows="4" required placeholder="Please provide a detailed reason for rejection..."></textarea>
                        <small class="text-muted">This reason will be shared with the parent.</small>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Confirm Rejection</button>
                </div>
            </form>
        </div>
    </div>
</div>