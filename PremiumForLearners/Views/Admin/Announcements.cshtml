@model List<PremiumForLearners.Models.Announcement>

@{
    ViewData["Title"] = "Announcements - Admin";
}

<!-- Add Font Awesome if not already in layout -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="display-6">
                <i class="fas fa-bullhorn me-2"></i>Announcements
            </h1>
            <p class="text-muted">Manage school-wide announcements and notifications</p>
        </div>
        <a href="/Admin/CreateAnnouncement" class="btn btn-primary btn-lg">
            <i class="fas fa-plus me-2"></i>New Announcement
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center py-5">
            <i class="fas fa-info-circle fa-3x mb-3 d-block"></i>
            <h4>No announcements yet</h4>
            <p>Click the "New Announcement" button to create your first announcement.</p>
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var announcement in Model)
            {
                <div class="col-md-6 col-lg-4 mb-4">
                    <div class="card h-100 shadow-sm hover-shadow transition-all">
                        <div class="card-header @(announcement.IsUrgent ? "bg-danger text-white" : "bg-light")">
                            <div class="d-flex justify-content-between align-items-center">
                                <h5 class="mb-0 fw-bold">
                                    @if (announcement.IsUrgent)
                                    {
                                        <i class="fas fa-exclamation-triangle me-2"></i>
                                    }
                                    else
                                    {
                                        <i class="fas fa-bullhorn me-2"></i>
                                    }
                                    @announcement.Title
                                </h5>
                                @if (announcement.IsUrgent)
                                {
                                    <span class="badge bg-light text-danger">URGENT</span>
                                }
                            </div>
                        </div>
                        <div class="card-body">
                            <p class="card-text">@announcement.Content</p>
                            <hr />
                            <div class="small text-muted">
                                <div class="mb-1">
                                    <i class="fas fa-users me-1"></i>
                                    <strong>Audience:</strong> @(announcement.TargetAudience ?? "All")
                                </div>
                                <div class="mb-1">
                                    <i class="fas fa-calendar-alt me-1"></i>
                                    <strong>Created:</strong> @announcement.CreatedAt.ToString("dd MMM yyyy, HH:mm")
                                </div>
                                @if (announcement.ExpiresAt.HasValue)
                                {
                                    <div class="mb-1">
                                        <i class="fas fa-hourglass-end me-1"></i>
                                        <strong>Expires:</strong> @announcement.ExpiresAt.Value.ToString("dd MMM yyyy")
                                    </div>
                                }
                                @if (!string.IsNullOrEmpty(announcement.CreatedBy))
                                {
                                    <div>
                                        <i class="fas fa-user me-1"></i>
                                        <strong>By:</strong> @announcement.CreatedBy
                                    </div>
                                }
                            </div>
                        </div>
                        <div class="card-footer bg-white border-top-0">
                            <form asp-action="DeleteAnnouncementConfirmed" asp-route-id="@announcement.Id" method="post" onsubmit="return confirm('Are you sure you want to delete this announcement? This action cannot be undone.');">
                                <button type="submit" class="btn btn-outline-danger btn-sm w-100">
                                    <i class="fas fa-trash-alt me-1"></i> Delete Announcement
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<style>
    .hover-shadow {
        transition: all 0.3s ease;
    }

        .hover-shadow:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 30px rgba(0,0,0,0.1) !important;
        }

    .transition-all {
        transition: all 0.3s ease;
    }
</style>