@model PremiumForLearners.Models.Payment
@{
    var student = ViewBag.Student as PremiumForLearners.Models.Student;
    var feeTypes = ViewBag.FeeTypes as List<PremiumForLearners.Models.FeeStructure>;
    ViewData["Title"] = "Make Payment";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <title>PremiumForLearners - Secure Payment Portal</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body, html {
            width: 100%;
            height: 100%;
            overflow: hidden;
            font-family: 'Inter', sans-serif;
            background: radial-gradient(circle at 30% 20%, #0a0a1a 0%, #020208 100%);
        }

        .full-scene {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            perspective: 2000px;
            perspective-origin: 50% 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 1;
        }

        .master-card-full {
            width: 100vw;
            height: 100vh;
            position: relative;
            transform-style: preserve-3d;
            transform: rotateY(0deg) rotateX(0deg);
            transition: transform 0.8s cubic-bezier(0.2, 0.9, 0.4, 1.1);
            cursor: pointer;
        }

            .master-card-full.flipped {
                transform: rotateY(180deg);
            }

        .card-front-full {
            position: absolute;
            width: 100%;
            height: 100%;
            background: linear-gradient(145deg, #ffffff 0%, #f5f7ff 100%);
            backface-visibility: hidden;
            box-shadow: 0 0 0 2px rgba(255,255,255,0.1);
            overflow: hidden;
            transform: translateZ(60px);
        }

        .card-back-full {
            position: absolute;
            width: 100%;
            height: 100%;
            background: linear-gradient(145deg, #ffffff 0%, #fafcff 100%);
            backface-visibility: hidden;
            transform: rotateY(180deg) translateZ(60px);
            overflow-y: auto;
            overflow-x: hidden;
        }

            .card-back-full::-webkit-scrollbar {
                width: 8px;
            }

            .card-back-full::-webkit-scrollbar-track {
                background: #f0f0f0;
            }

            .card-back-full::-webkit-scrollbar-thumb {
                background: #000;
                border-radius: 10px;
            }

        /* Front Content */
        .front-content {
            position: relative;
            height: 100%;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            padding: 60px 80px;
        }

        .floating-bg {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            overflow: hidden;
        }

        .particle {
            position: absolute;
            background: radial-gradient(circle, rgba(0,0,0,0.03) 0%, transparent 70%);
            border-radius: 50%;
            animation: floatParticle 15s infinite ease-in-out;
        }

        @@keyframes floatParticle {
            0%, 100% {
                transform: translateY(0px) translateX(0px) rotate(0deg);
            }

            50% {
                transform: translateY(-30px) translateX(20px) rotate(5deg);
            }
        }

        .hero-card-3d {
            background: linear-gradient(135deg, #1a1a2e 0%, #0f0f1a 100%);
            border-radius: 48px;
            padding: 48px;
            max-width: 550px;
            transform: rotate(-3deg) translateY(20px);
            box-shadow: 0 50px 80px -30px rgba(0,0,0,0.5);
            transition: transform 0.4s;
        }

            .hero-card-3d:hover {
                transform: rotate(-2deg) translateY(10px);
            }

        .chip-glow {
            width: 60px;
            height: 48px;
            background: linear-gradient(135deg, #ffd966, #ffb347);
            border-radius: 12px;
            box-shadow: 0 0 20px rgba(255,180,70,0.3);
        }

        .card-number-large {
            font-family: monospace;
            font-size: 1.8rem;
            letter-spacing: 4px;
            color: white;
            margin: 40px 0 20px;
        }

        .flip-button {
            position: fixed;
            bottom: 40px;
            right: 60px;
            background: #000;
            color: white;
            border: none;
            border-radius: 80px;
            padding: 16px 40px;
            font-weight: 700;
            font-size: 1rem;
            cursor: pointer;
            z-index: 100;
            transition: all 0.3s;
            box-shadow: 0 10px 30px rgba(0,0,0,0.3);
        }

            .flip-button:hover {
                background: #333;
                transform: scale(1.05);
            }

        .close-button {
            position: sticky;
            top: 30px;
            float: right;
            background: #000;
            color: white;
            border: none;
            border-radius: 60px;
            padding: 10px 28px;
            font-size: 0.85rem;
            font-weight: 600;
            cursor: pointer;
            z-index: 200;
            margin: 30px 40px 0 0;
            transition: all 0.2s;
            opacity: 0;
            transform: translateY(-20px);
        }

            .close-button.animate-in {
                animation: fadeSlideDown 0.5s forwards;
            }

        .form-container {
            max-width: 700px;
            margin: 0 auto;
            padding: 40px 60px 80px;
        }

        .reveal-item {
            opacity: 0;
            transform: translateY(30px);
        }

            .reveal-item.animated {
                animation: slideUpReveal 0.6s forwards;
            }

        @@keyframes slideUpReveal {
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @@keyframes fadeSlideDown {
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .form-label-modern {
            font-weight: 700;
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            color: #666;
            margin-bottom: 8px;
            display: block;
        }

        .input-modern {
            width: 100%;
            padding: 16px 20px;
            border: 2px solid #eef2f6;
            border-radius: 28px;
            font-size: 1rem;
            transition: all 0.3s;
            background: white;
        }

            .input-modern:focus {
                outline: none;
                border-color: #000;
                box-shadow: 0 5px 20px rgba(0,0,0,0.05);
            }

        /* Bank Flow - Icon Style */
        .bank-flow-full {
            display: flex;
            gap: 16px;
            overflow-x: auto;
            scroll-behavior: smooth;
            padding: 10px 0 20px;
            scrollbar-width: thin;
        }

            .bank-flow-full::-webkit-scrollbar {
                height: 4px;
            }

            .bank-flow-full::-webkit-scrollbar-track {
                background: #eef2f6;
                border-radius: 10px;
            }

            .bank-flow-full::-webkit-scrollbar-thumb {
                background: #000;
                border-radius: 10px;
            }

        .bank-item-full {
            flex: 0 0 auto;
            width: 100px;
            background: white;
            border: 2px solid #eef2f6;
            border-radius: 32px;
            padding: 18px 12px;
            text-align: center;
            cursor: pointer;
            transition: all 0.3s;
            opacity: 0;
            transform: translateY(20px);
        }

            .bank-item-full:hover {
                transform: translateY(-5px);
                border-color: #000;
                box-shadow: 0 15px 30px -12px rgba(0,0,0,0.15);
            }

            .bank-item-full.active {
                border-color: #000;
                background: linear-gradient(135deg, #fff, #fafafa);
            }

        .bank-icon {
            font-size: 2.2rem;
            margin-bottom: 10px;
            display: block;
        }

        .bank-name {
            font-size: 12px;
            font-weight: 600;
            display: block;
        }

        /* Payment Options */
        .payment-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
            gap: 12px;
        }

        .payment-card-option {
            border: 2px solid #eef2f6;
            border-radius: 28px;
            padding: 16px;
            text-align: center;
            cursor: pointer;
            transition: all 0.2s;
            background: white;
        }

            .payment-card-option.active {
                border-color: #000;
                background: #fafafa;
            }

        .card-panel-slide {
            max-height: 0;
            overflow: hidden;
            transition: max-height 0.8s cubic-bezier(0.33, 1, 0.68, 1);
            background: #f8fafd;
            border-radius: 40px;
            margin-top: 24px;
        }

            .card-panel-slide.open {
                max-height: 700px;
                padding: 28px;
            }

        .mini-card-display {
            background: linear-gradient(135deg, #1a1a2e, #0f0f1a);
            border-radius: 28px;
            padding: 24px;
            color: white;
            margin-bottom: 24px;
        }

        .pay-btn-full {
            width: 100%;
            padding: 18px;
            background: #000;
            color: white;
            border: none;
            border-radius: 48px;
            font-weight: 700;
            font-size: 1rem;
            transition: all 0.3s;
        }

            .pay-btn-full:hover {
                background: #333;
                transform: translateY(-2px);
            }

        .amount-large-input {
            font-size: 2.5rem;
            font-weight: 800;
            text-align: center;
        }

        @@media (max-width: 768px) {
            .front-content {
                padding: 30px 24px;
            }

            .hero-card-3d {
                padding: 24px;
            }

            .card-number-large {
                font-size: 1rem;
            }

            .form-container {
                padding: 20px 24px 60px;
            }

            .flip-button {
                bottom: 20px;
                right: 20px;
                padding: 12px 24px;
            }

            .bank-item-full {
                width: 85px;
            }

            .bank-icon {
                font-size: 1.6rem;
            }
        }
    </style>
</head>
<body>

    <div class="full-scene">
        <div class="master-card-full" id="masterCardFull">

            <!-- FRONT SIDE -->
            <div class="card-front-full">
                <div class="floating-bg">
                    @for (int i = 0; i < 15; i++)
                    {
                        <div class="particle" style="width: @(new Random().Next(100, 400))px; height: @(new Random().Next(100, 400))px; top: @(new Random().Next(0, 100))%; left: @(new Random().Next(0, 100))%; animation-delay: @(new Random().Next(0, 5))s; animation-duration: @(new Random().Next(10, 20))s;"></div>
                    }
                </div>

                <div class="front-content">
                    <div>
                        <div class="d-inline-block bg-dark bg-opacity-10 rounded-pill px-4 py-2 mb-5">
                            <i class="fas fa-shield-alt me-2"></i> SECURE PAYMENT
                        </div>
                    </div>

                    <div class="row align-items-center h-100">
                        <div class="col-lg-7 mb-5 mb-lg-0">
                            <h1 class="display-1 fw-bold" style="font-size: 5rem; line-height: 1.1;">Secure<br>Payment Portal</h1>
                            <p class="lead text-muted mt-4" style="max-width: 500px;">PremiumForLearners trusted gateway. Instant, secure, and protected by PayFast.</p>
                            <div class="d-flex gap-3 mt-4">
                                <i class="fab fa-cc-visa fa-2x text-muted"></i>
                                <i class="fab fa-cc-mastercard fa-2x text-muted"></i>
                                <i class="fab fa-cc-amex fa-2x text-muted"></i>
                            </div>
                        </div>
                        <div class="col-lg-5">
                            <div class="hero-card-3d">
                                <div class="chip-glow"></div>
                                <div class="card-number-large mt-4">•••• •••• •••• 8899</div>
                                <div class="d-flex justify-content-between text-white-50">
                                    <span>EMILY CARTER</span>
                                    <span>12/28</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="text-end">
                        <small class="text-muted">⚡ 2,847 transactions today</small>
                    </div>
                </div>
            </div>

            <!-- BACK SIDE - WITH ICON BANKS -->
            <div class="card-back-full" id="cardBackFull">
                <button class="close-button" id="closeBtn" onclick="flipCardFull()">
                    <i class="fas fa-arrow-left me-2"></i> Back to cover
                </button>

                <div class="form-container" id="formContainer">
                    <div class="reveal-item" data-delay="0">
                        <h2 class="fw-bold" style="font-size: 2.8rem;">Complete Payment</h2>
                        <p class="text-muted">Fill in your details to complete the secure transaction</p>
                    </div>

                    @if (student != null)
                    {
                        <div class="reveal-item" data-delay="100">
                            <div class="d-flex align-items-center gap-3 p-4 bg-light rounded-4 mb-5">
                                <div class="bg-dark text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
                                    <i class="fas fa-user-graduate fa-2x"></i>
                                </div>
                                <div>
                                    <h5 class="mb-0 fw-bold">@student.FullName</h5>
                                    <small class="text-muted">Grade @student.ApplyingGrade</small>
                                </div>
                            </div>
                        </div>
                    }

                    <form asp-action="MakePayment" method="post" id="paymentFormFull">
                        <input type="hidden" asp-for="StudentId" />
                        <input type="hidden" asp-for="PaymentDate" value="@DateTime.Now.ToString("yyyy-MM-dd")" />
                        <input type="hidden" asp-for="Reference" id="referenceFull" />
                        <input type="hidden" asp-for="PaymentMethod" id="selectedBankFull" />

                        <!-- Payment Type Section -->
                        <div class="reveal-item" data-delay="200">
                            <label class="form-label-modern">PAYMENT TYPE</label>
                            <div class="payment-grid" id="paymentGrid">
                                @if (feeTypes != null && feeTypes.Any())
                                {
                                    @foreach (var fee in feeTypes)
                                    {
                                        <div class="payment-card-option" data-type="@fee.FeeType" data-amount="@fee.Amount">
                                            <i class="fas fa-receipt fa-2x mb-2"></i>
                                            <div class="fw-bold">@fee.FeeType</div>
                                            <small>R @fee.Amount.ToString("N0")</small>
                                        </div>
                                    }
                                }
                                <div class="payment-card-option" data-type="School Fees" data-amount="0">
                                    <i class="fas fa-school fa-2x mb-2"></i>
                                    <div class="fw-bold">School Fees</div>
                                    <small>Custom</small>
                                </div>
                                <div class="payment-card-option" data-type="Uniform" data-amount="0">
                                    <i class="fas fa-tshirt fa-2x mb-2"></i>
                                    <div class="fw-bold">Uniform</div>
                                    <small>Custom</small>
                                </div>
                                <div class="payment-card-option" data-type="Transport" data-amount="0">
                                    <i class="fas fa-bus fa-2x mb-2"></i>
                                    <div class="fw-bold">Transport</div>
                                    <small>Custom</small>
                                </div>
                            </div>
                            <input type="hidden" id="selectedPaymentTypeFull" name="PaymentType" required />
                        </div>

                        <!-- Amount Section -->
                        <div class="reveal-item" data-delay="300">
                            <label class="form-label-modern">AMOUNT (R)</label>
                            <input asp-for="Amount" class="input-modern amount-large-input" type="number" step="0.01" placeholder="0.00" required id="amountFull" />
                        </div>

                        <!-- BANK CAROUSEL - ALL ICONS NO LOGOS -->
                        <div class="reveal-item" data-delay="400">
                            <label class="form-label-modern">SELECT YOUR BANK</label>
                            <div class="bank-flow-full" id="bankFlowFull">
                                @{
                                    var banksFull = new[] {
                                                                new { name = "FNB", icon = "fas fa-building", color = "#0066cc", delay = 50 },
                                                                new { name = "ABSA", icon = "fas fa-landmark", color = "#cc0000", delay = 100 },
                                                                new { name = "Standard Bank", icon = "fas fa-university", color = "#006633", delay = 150 },
                                                                new { name = "Capitec", icon = "fas fa-piggy-bank", color = "#ff6600", delay = 200 },
                                                                new { name = "Nedbank", icon = "fas fa-chart-line", color = "#0099cc", delay = 250 },
                                                                new { name = "Discovery", icon = "fas fa-heartbeat", color = "#00a86b", delay = 300 },
                                                                new { name = "TymeBank", icon = "fas fa-clock", color = "#e31b23", delay = 350 },
                                                                new { name = "African Bank", icon = "fas fa-globe-africa", color = "#d4af37", delay = 400 },
                                                                new { name = "Bidvest", icon = "fas fa-chart-simple", color = "#004d99", delay = 450 },
                                                                new { name = "Investec", icon = "fas fa-gem", color = "#800080", delay = 500 }
                                                                };
                                }
                                @foreach (var bank in banksFull)
                                {
                                    <div class="bank-item-full" data-bank="@bank.name" data-delay="@bank.delay">
                                        <i class="@bank.icon bank-icon" style="color: @bank.color;"></i>
                                        <span class="bank-name">@bank.name</span>
                                    </div>
                                }
                            </div>
                            <div class="text-center mt-2" id="scrollHint" style="opacity: 0;">
                                <small class="text-muted"><i class="fas fa-arrows-left-right me-1"></i> Scroll to see all banks</small>
                            </div>
                        </div>

                        <!-- Card Payment Panel -->
                        <div id="cardPanelFull" class="card-panel-slide">
                            <div class="reveal-item-inner" style="opacity: 0;">
                                <div class="mini-card-display">
                                    <div class="d-flex justify-content-between">
                                        <div style="width: 45px; height: 38px; background: linear-gradient(135deg, #ffd966, #ffb347); border-radius: 8px;"></div>
                                        <i class="fab fa-cc-visa fa-2x opacity-50"></i>
                                    </div>
                                    <div class="mt-3">
                                        <div class="fw-bold font-monospace fs-5" id="cardPreviewNumFull">•••• •••• •••• ••••</div>
                                        <div class="d-flex justify-content-between mt-3">
                                            <span id="cardPreviewNameFull" class="small text-white-50">YOUR NAME</span>
                                            <span id="cardPreviewExpiryFull" class="small text-white-50">MM/YY</span>
                                        </div>
                                    </div>
                                </div>

                                <div class="row g-3">
                                    <div class="col-12">
                                        <label class="form-label-modern">CARD NUMBER</label>
                                        <input type="text" class="input-modern" id="cardNumberFull" placeholder="1234 5678 9012 3456" maxlength="19">
                                    </div>
                                    <div class="col-12">
                                        <label class="form-label-modern">NAME ON CARD</label>
                                        <input type="text" class="input-modern" id="cardNameFull" placeholder="As it appears on card">
                                    </div>
                                    <div class="col-6">
                                        <label class="form-label-modern">EXPIRY DATE</label>
                                        <input type="text" class="input-modern" id="expiryDateFull" placeholder="MM/YY" maxlength="5">
                                    </div>
                                    <div class="col-6">
                                        <label class="form-label-modern">CVV</label>
                                        <input type="text" class="input-modern" id="cvvFull" placeholder="123" maxlength="4">
                                    </div>
                                </div>

                                <div class="form-check mt-4">
                                    <input class="form-check-input" type="checkbox" id="termsFull" required>
                                    <label class="form-check-label small">
                                        I authorize this payment to PremiumForLearners
                                    </label>
                                </div>

                                <button type="button" class="pay-btn-full mt-4" id="payBtnFull" onclick="processPaymentFull()">
                                    <i class="fas fa-lock me-2"></i> Pay Now
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <button class="flip-button" id="flipBtnFull" onclick="flipCardFull()">
        <i class="fas fa-credit-card me-2"></i> Make Payment →
    </button>

    <script>
        // Generate reference
        const reference = 'PFL-' + Date.now() + '-' + Math.random().toString(36).substr(2, 8).toUpperCase();
        document.getElementById('referenceFull').value = reference;

        let animationsTriggered = false;

        function flipCardFull() {
            const card = document.getElementById('masterCardFull');
            card.classList.toggle('flipped');

            if (card.classList.contains('flipped')) {
                setTimeout(() => {
                    triggerStaggeredReveal();
                }, 300);
            } else {
                animationsTriggered = false;
                document.querySelectorAll('.reveal-item').forEach(el => {
                    el.classList.remove('animated');
                    el.style.opacity = '0';
                    el.style.transform = 'translateY(30px)';
                });
                document.getElementById('closeBtn')?.classList.remove('animate-in');
                document.getElementById('scrollHint').style.opacity = '0';
            }
        }

        function triggerStaggeredReveal() {
            if (animationsTriggered) return;
            animationsTriggered = true;

            const revealItems = document.querySelectorAll('.reveal-item');

            setTimeout(() => {
                const closeBtn = document.getElementById('closeBtn');
                if (closeBtn) closeBtn.classList.add('animate-in');
            }, 100);

            revealItems.forEach((item, index) => {
                const delay = parseInt(item.getAttribute('data-delay')) || (index * 120);
                setTimeout(() => {
                    item.classList.add('animated');
                }, delay);
            });

            setTimeout(() => {
                const hint = document.getElementById('scrollHint');
                if (hint) {
                    hint.style.transition = 'opacity 0.5s ease';
                    hint.style.opacity = '1';
                }
            }, 800);

            setTimeout(() => {
                const bankItems = document.querySelectorAll('.bank-item-full');
                bankItems.forEach((item, idx) => {
                    const delay = parseInt(item.getAttribute('data-delay')) || (idx * 40);
                    setTimeout(() => {
                        item.style.opacity = '1';
                        item.style.transform = 'translateY(0)';
                        item.style.transition = 'all 0.4s cubic-bezier(0.2, 0.9, 0.4, 1.1)';
                    }, delay + 500);
                });
            }, 200);
        }

        // Set initial hidden state for bank items
        document.querySelectorAll('.bank-item-full').forEach(item => {
            item.style.opacity = '0';
            item.style.transform = 'translateY(20px)';
        });

        // Animate front elements on load
        gsap.fromTo('.hero-card-3d',
            { opacity: 0, y: 50, rotate: -10 },
            { opacity: 1, y: 20, rotate: -3, duration: 0.8, delay: 0.3 }
        );
        gsap.fromTo('.display-1',
            { opacity: 0, y: 30 },
            { opacity: 1, y: 0, duration: 0.6, delay: 0.2 }
        );

        // Payment type selection
        document.querySelectorAll('.payment-card-option').forEach(opt => {
            opt.addEventListener('click', function() {
                document.querySelectorAll('.payment-card-option').forEach(o => o.classList.remove('active'));
                this.classList.add('active');
                document.getElementById('selectedPaymentTypeFull').value = this.getAttribute('data-type');
                const amount = this.getAttribute('data-amount');
                if (amount && amount !== '0') {
                    document.getElementById('amountFull').value = amount;
                }
            });
        });

        // Bank selection - open card panel
        document.querySelectorAll('.bank-item-full').forEach(bank => {
            bank.addEventListener('click', function() {
                document.querySelectorAll('.bank-item-full').forEach(b => b.classList.remove('active'));
                this.classList.add('active');
                document.getElementById('selectedBankFull').value = this.getAttribute('data-bank');

                const panel = document.getElementById('cardPanelFull');
                panel.classList.add('open');

                setTimeout(() => {
                    const inner = panel.querySelector('.reveal-item-inner');
                    if (inner) {
                        inner.style.transition = 'opacity 0.5s ease, transform 0.5s ease';
                        inner.style.opacity = '1';
                        inner.style.transform = 'translateY(0)';
                    }
                }, 200);

                setTimeout(() => {
                    panel.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
                }, 300);
            });
        });

        const panelInner = document.querySelector('#cardPanelFull .reveal-item-inner');
        if (panelInner) {
            panelInner.style.opacity = '0';
            panelInner.style.transform = 'translateY(20px)';
        }

        // Card formatting
        document.getElementById('cardNumberFull')?.addEventListener('input', function(e) {
            let val = e.target.value.replace(/\s/g, '');
            if (val.length > 16) val = val.slice(0, 16);
            let formatted = val.match(/.{1,4}/g)?.join(' ') || val;
            e.target.value = formatted;
            document.getElementById('cardPreviewNumFull').innerText = formatted || '•••• •••• •••• ••••';
        });

        document.getElementById('expiryDateFull')?.addEventListener('input', function(e) {
            let val = e.target.value.replace(/\D/g, '');
            if (val.length >= 2) val = val.slice(0,2) + '/' + val.slice(2,4);
            e.target.value = val;
            document.getElementById('cardPreviewExpiryFull').innerText = val || 'MM/YY';
        });

        document.getElementById('cardNameFull')?.addEventListener('input', function(e) {
            let val = e.target.value.toUpperCase();
            document.getElementById('cardPreviewNameFull').innerText = val || 'YOUR NAME';
        });

        function processPaymentFull() {
            const amount = document.getElementById('amountFull').value;
            const paymentType = document.getElementById('selectedPaymentTypeFull').value;
            const bank = document.getElementById('selectedBankFull').value;
            const terms = document.getElementById('termsFull').checked;

            if (!paymentType) { alert('Please select what you are paying for'); return; }
            if (!amount || amount <= 0) { alert('Please enter a valid amount'); return; }
            if (!bank) { alert('Please select your bank'); return; }
            if (!terms) { alert('Please agree to the terms'); return; }

            const cardNum = document.getElementById('cardNumberFull')?.value.replace(/\s/g, '');
            const cardName = document.getElementById('cardNameFull')?.value;
            const expiry = document.getElementById('expiryDateFull')?.value;
            const cvv = document.getElementById('cvvFull')?.value;

            if (!cardNum || cardNum.length < 16) { alert('Please enter a valid card number'); return; }
            if (!cardName) { alert('Please enter name on card'); return; }
            if (!expiry || expiry.length < 5) { alert('Please enter expiry date (MM/YY)'); return; }
            if (!cvv || cvv.length < 3) { alert('Please enter CVV'); return; }

            const btn = document.getElementById('payBtnFull');
            btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Processing...';
            btn.disabled = true;

            document.getElementById('selectedBankFull').value = bank + ' - Card Payment';
            document.getElementById('paymentFormFull').submit();
        }
    </script>

</body>
</html>