@model PremiumForLearners.Models.Parent

@{
    ViewData["Title"] = "Parent Dashboard";
}

<!-- Bootstrap 5 CSS -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
<!-- Font Awesome 6 -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
<!-- Google Fonts -->
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:wght@400;500;600;700&display=swap" rel="stylesheet">
<!-- AOS Animation -->
<link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">

<style>
    :root {
        --black: #000000;
        --white: #ffffff;
        --gray-dark: #1a1a1a;
        --gray-medium: #2c2c2c;
        --gray-light: #3a3a3a;
        --gray-lighter: #f5f5f5;
        --gray-text: #6b6b6b;
        --gray-border: #333333;
        --success-green: #28a745;
        --warning-orange: #fd7e14;
        --danger-red: #dc3545;
        --info-blue: #17a2b8;
    }

    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    body {
        font-family: 'Inter', sans-serif;
        background-color: var(--white);
        color: var(--gray-text);
        line-height: 1.6;
        overflow-x: hidden;
    }

    h1, h2, h3, h4, h5, h6 {
        font-family: 'Playfair Display', serif;
        color: var(--black);
    }

    /* Navigation */
    .navbar {
        background-color: var(--white) !important;
        box-shadow: 0 2px 20px rgba(0,0,0,0.05);
        padding: 15px 0;
        border-bottom: 1px solid #eee;
    }

    .navbar-brand {
        font-family: 'Playfair Display', serif;
        font-weight: 700;
        color: var(--black) !important;
        font-size: 1.8rem;
    }

    .nav-link {
        color: var(--gray-medium) !important;
        font-weight: 500;
        margin: 0 15px;
        transition: color 0.3s ease;
    }

        .nav-link:hover {
            color: var(--black) !important;
        }

    /* Hero Section */
    .parent-hero {
        padding: 40px 0 30px;
        background: linear-gradient(135deg, var(--gray-lighter) 0%, var(--white) 100%);
        position: relative;
        overflow: hidden;
        margin-bottom: 40px;
    }

        .parent-hero::before {
            content: '';
            position: absolute;
            top: -50%;
            right: -10%;
            width: 500px;
            height: 500px;
            background: radial-gradient(circle, #e0e0e0 0%, transparent 70%);
            border-radius: 50%;
            opacity: 0.3;
        }

    .parent-hero-content {
        position: relative;
        z-index: 2;
    }

    .parent-hero h1 {
        font-size: 2.5rem;
        font-weight: 700;
        margin-bottom: 10px;
    }

    .parent-badge {
        display: inline-block;
        padding: 4px 12px;
        background: var(--black);
        color: white;
        border-radius: 40px;
        font-size: 0.75rem;
        font-weight: 500;
        margin-bottom: 15px;
    }

    /* Stats Cards */
    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 20px;
        margin-bottom: 40px;
    }

    .stat-card {
        background: var(--white);
        border-radius: 24px;
        padding: 24px 20px;
        box-shadow: 0 5px 20px rgba(0,0,0,0.03);
        border: 1px solid #e8e8e8;
        transition: all 0.3s cubic-bezier(0.2, 0.9, 0.4, 1.1);
    }

        .stat-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 30px rgba(0,0,0,0.08);
            border-color: var(--black);
        }

    .stat-icon {
        width: 50px;
        height: 50px;
        background: var(--gray-lighter);
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 16px;
    }

        .stat-icon i {
            font-size: 1.5rem;
            color: var(--black);
        }

    .stat-number {
        font-size: 2rem;
        font-weight: 800;
        color: var(--black);
        margin-bottom: 5px;
    }

    .stat-label {
        color: var(--gray-text);
        font-size: 0.85rem;
    }

    /* Quick Actions */
    .quick-actions {
        display: flex;
        gap: 15px;
        flex-wrap: wrap;
        margin-bottom: 40px;
    }

    .action-btn {
        background: var(--gray-lighter);
        border: 1px solid #e0e0e0;
        border-radius: 50px;
        padding: 12px 24px;
        text-decoration: none;
        color: var(--black);
        font-weight: 500;
        font-size: 0.9rem;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

        .action-btn:hover {
            background: var(--black);
            color: white;
            transform: translateY(-2px);
            border-color: var(--black);
        }

    /* Cards */
    .card-modern {
        background: var(--white);
        border-radius: 24px;
        border: 1px solid #e8e8e8;
        overflow: hidden;
        margin-bottom: 30px;
        transition: all 0.3s ease;
    }

        .card-modern:hover {
            box-shadow: 0 10px 30px rgba(0,0,0,0.05);
        }

    .card-header-modern {
        background: var(--gray-lighter);
        padding: 20px 24px;
        border-bottom: 1px solid #e0e0e0;
    }

        .card-header-modern h5 {
            margin: 0;
            font-size: 1.1rem;
            font-weight: 600;
        }

    /* Child Cards */
    .child-card {
        background: var(--white);
        border-radius: 20px;
        border: 1px solid #e8e8e8;
        transition: all 0.3s ease;
        height: 100%;
    }

        .child-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 30px rgba(0,0,0,0.08);
        }

    /* Footer */
    .footer {
        background-color: var(--black);
        color: var(--white);
        padding: 40px 0 30px;
        margin-top: 60px;
    }

        .footer a {
            color: #a0a0a0;
            text-decoration: none;
        }

            .footer a:hover {
                color: var(--white);
            }

    /* Responsive */
    @@media (max-width: 768px) {
        .stats-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .parent-hero h1 {
            font-size: 1.8rem;
        }
    }
</style>

<!-- Navigation -->
<nav class="navbar navbar-expand-lg fixed-top">
    <div class="container">
        <a class="navbar-brand" href="/">PremiumForLearners</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav ms-auto">
                <li class="nav-item"><a class="nav-link" href="/Parent/Dashboard">Dashboard</a></li>
                <li class="nav-item"><a class="nav-link" href="/Parent/Notifications">Notifications</a></li>
                <li class="nav-item"><a class="nav-link" href="/Parent/Announcements">Announcements</a></li>
                <li class="nav-item"><a class="nav-link" href="/Account/Logout">Logout</a></li>
            </ul>
        </div>
    </div>
</nav>

<!-- Hero Section -->
<section class="parent-hero">
    <div class="container">
        <div class="parent-hero-content" data-aos="fade-up">
            <div class="parent-badge">Parent Portal</div>
            <h1>Welcome back, @Model.FullName!</h1>
            <p class="text-muted">Manage your children's registrations and school activities</p>
        </div>
    </div>
</section>

<div class="container">
    <!-- Alerts -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-triangle me-2"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Stats Cards -->
    @{
        var totalChildren = Model.Children.Count();
        var enrolledCount = Model.Children.Count(c => c.ApplicationStatus == "Enrolled");
        var pendingCount = Model.Children.Count(c => c.ApplicationStatus == "Submitted" || c.ApplicationStatus == "DocumentsVerified" || c.ApplicationStatus == "SubjectsVerified" || c.ApplicationStatus == "PaymentVerified");
    }

    <div class="stats-grid" data-aos="fade-up">
        <div class="stat-card">
            <div class="stat-icon"><i class="fas fa-child"></i></div>
            <div class="stat-number">@totalChildren</div>
            <div class="stat-label">Total Children</div>
        </div>
        <div class="stat-card">
            <div class="stat-icon"><i class="fas fa-graduation-cap"></i></div>
            <div class="stat-number text-success">@enrolledCount</div>
            <div class="stat-label">Enrolled</div>
        </div>
        <div class="stat-card">
            <div class="stat-icon"><i class="fas fa-clock"></i></div>
            <div class="stat-number text-warning">@pendingCount</div>
            <div class="stat-label">Pending</div>
        </div>
        <div class="stat-card">
            <div class="stat-icon"><i class="fas fa-credit-card"></i></div>
            <div class="stat-number">@(ViewBag.PaymentSummary?.TotalPaid.ToString("N0") ?? "0")</div>
            <div class="stat-label">Total Paid (R)</div>
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="quick-actions" data-aos="fade-up" data-aos-delay="100">
        <a href="/Parent/AddStudent" class="action-btn"><i class="fas fa-user-plus"></i> Add Child</a>
        <a href="/Parent/Payments" class="action-btn"><i class="fas fa-credit-card"></i> Payments</a>
        <a href="/Parent/Announcements" class="action-btn"><i class="fas fa-bullhorn"></i> Announcements</a>
        <a href="/Parent/Notifications" class="action-btn"><i class="fas fa-bell"></i> Notifications</a>
    </div>

    <!-- Helper function to check payment status -->
    @{
        bool HasVerifiedPayment(int studentId)
        {
            if (ViewBag.Payments != null)
            {
                var payments = ViewBag.Payments as List<PremiumForLearners.Models.Payment>;
                return payments?.Any(p => p.StudentId == studentId && p.Status == "Verified") ?? false;
            }
            return false;
        }

        bool HasPendingPayment(int studentId)
        {
            if (ViewBag.Payments != null)
            {
                var payments = ViewBag.Payments as List<PremiumForLearners.Models.Payment>;
                return payments?.Any(p => p.StudentId == studentId && p.Status == "Pending") ?? false;
            }
            return false;
        }
    }

    <!-- My Children Section -->
    <div class="card-modern" data-aos="fade-up" data-aos-delay="200">
        <div class="card-header-modern d-flex justify-content-between align-items-center">
            <h5><i class="fas fa-users me-2"></i>My Children</h5>
            <a href="/Parent/AddStudent" class="btn btn-sm btn-outline-primary">+ Add Child</a>
        </div>
        <div class="card-body p-4">
            @if (Model.Children.Any())
            {
                <div class="row">
                    @foreach (var child in Model.Children)
                    {
                        var hasVerifiedPayment = HasVerifiedPayment(child.Id);
                        var hasPendingPayment = HasPendingPayment(child.Id);

                        <div class="col-md-6 col-lg-4 mb-4">
                            <div class="child-card p-3">
                                <div class="d-flex justify-content-between align-items-start mb-3">
                                    <div>
                                        <h5 class="mb-1">@child.FullName</h5>
                                        <p class="text-muted mb-0 small">Grade @child.ApplyingGrade • Age @child.Age</p>
                                    </div>
                                    <span class="status-badge @(child.ApplicationStatus == "Enrolled" ? "bg-success text-white" :
                                                                                                         child.ApplicationStatus == "Approved" ? "bg-info text-white" :
                                                                                                         child.ApplicationStatus == "Submitted" ? "bg-warning text-dark" :
                                                                                                         child.ApplicationStatus == "DocumentsVerified" ? "bg-primary text-white" :
                                                                                                         child.ApplicationStatus == "SubjectsVerified" ? "bg-primary text-white" :
                                                                                                         child.ApplicationStatus == "PaymentVerified" ? "bg-primary text-white" :
                                                                                                         child.ApplicationStatus == "Rejected" ? "bg-danger text-white" : "bg-secondary text-white")"
                                          style="padding: 4px 12px; border-radius: 40px; font-size: 0.7rem; font-weight: 600;">
                                        @child.ApplicationStatus
                                    </span>
                                </div>

                                <div class="progress mb-3" style="height: 6px;">
                                    <div class="progress-bar bg-success" role="progressbar"
                                         style="width: @(child.ApplicationStatus == "Enrolled" ? 100 : child.ApplicationStatus == "Approved" ? 80 : child.ApplicationStatus == "Submitted" ? 50 : 20)%">
                                    </div>
                                </div>

                                <div class="d-flex flex-wrap gap-2">
                                    <a href="/Parent/StudentDetails/@child.Id" class="btn btn-sm btn-outline-primary" style="border-radius: 20px; padding: 5px 12px; font-size: 0.75rem;">
                                        <i class="fas fa-eye me-1"></i> View
                                    </a>

                                    @if (child.ApplicationStatus == "Draft")
                                    {
                                        <form asp-action="SubmitApplication" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@child.Id" />
                                            <button type="submit" class="btn btn-sm btn-success" style="border-radius: 20px; padding: 5px 12px; font-size: 0.75rem;">
                                                <i class="fas fa-paper-plane me-1"></i> Submit
                                            </button>
                                        </form>
                                    }

                                    @if (child.ApplicationStatus == "Approved" && !hasVerifiedPayment && !hasPendingPayment)
                                    {
                                        <a href="/Parent/MakePayment/@child.Id" class="btn btn-sm btn-warning" style="border-radius: 20px; padding: 5px 12px; font-size: 0.75rem;">
                                            <i class="fas fa-credit-card me-1"></i> Pay Fee
                                        </a>
                                    }

                                    @if (child.ApplicationStatus == "Approved" && hasPendingPayment && !hasVerifiedPayment)
                                    {
                                        <button class="btn btn-sm btn-secondary" disabled style="border-radius: 20px; padding: 5px 12px; font-size: 0.75rem;">
                                            <i class="fas fa-clock me-1"></i> Pending
                                        </button>
                                    }

                                    @if (child.ApplicationStatus == "Approved" && hasVerifiedPayment)
                                    {
                                        <a href="/Parent/ConfirmEnrollment/@child.Id" class="btn btn-sm btn-success" style="border-radius: 20px; padding: 5px 12px; font-size: 0.75rem;">
                                            <i class="fas fa-check-circle me-1"></i> Enroll
                                        </a>
                                    }

                                    @if (int.TryParse(child.ApplyingGrade, out var grade) && grade >= 10 && grade <= 12)
                                    {
                                        <a href="/Parent/SubjectSelection/@child.Id" class="btn btn-sm btn-outline-secondary" style="border-radius: 20px; padding: 5px 12px; font-size: 0.75rem;">
                                            <i class="fas fa-book-open me-1"></i> Subjects
                                        </a>
                                    }

                                    @if (child.ApplicationStatus == "Enrolled")
                                    {
                                        <a href="/Parent/TransferRequest/@child.Id" class="btn btn-sm btn-outline-secondary" style="border-radius: 20px; padding: 5px 12px; font-size: 0.75rem;">
                                            <i class="fas fa-exchange-alt me-1"></i> Transfer
                                        </a>
                                    }

                                    <a href="/Parent/DocumentVault/@child.Id" class="btn btn-sm btn-outline-secondary" style="border-radius: 20px; padding: 5px 12px; font-size: 0.75rem;">
                                        <i class="fas fa-folder-open me-1"></i> Docs
                                    </a>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="fas fa-child fa-4x text-muted mb-3"></i>
                    <p class="lead">You haven't added any children yet.</p>
                    <a href="/Parent/AddStudent" class="btn btn-primary" style="border-radius: 40px; padding: 10px 24px;">Add Your First Child</a>
                </div>
            }
        </div>
    </div>

    <!-- Two Column Layout -->
    <div class="row">
        <!-- Notifications Section -->
        <div class="col-md-6 mb-4">
            <div class="card-modern h-100">
                <div class="card-header-modern">
                    <h5><i class="fas fa-bell me-2"></i>Recent Notifications</h5>
                </div>
                <div class="card-body p-4">
                    @if (ViewBag.Notifications != null && ViewBag.Notifications.Count > 0)
                    {
                        foreach (var notif in ViewBag.Notifications)
                        {
                            <div class="border-bottom pb-3 mb-3">
                                <strong class="d-block">@notif.Title</strong>
                                <p class="small text-muted mb-0">@notif.Message</p>
                                <small class="text-muted">@notif.CreatedAt.ToString("dd MMM")</small>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-muted text-center py-3 mb-0">No new notifications</p>
                    }
                </div>
            </div>
        </div>

        <!-- Payment Summary Section -->
        <div class="col-md-6 mb-4">
            <div class="card-modern h-100">
                <div class="card-header-modern">
                    <h5><i class="fas fa-credit-card me-2"></i>Payment Summary</h5>
                </div>
                <div class="card-body p-4">
                    @if (ViewBag.PaymentSummary != null)
                    {
                        <div class="row text-center">
                            <div class="col-6">
                                <div class="p-3 bg-success bg-opacity-10 rounded-3">
                                    <small class="text-muted">Total Paid</small>
                                    <h4 class="text-success mb-0 fw-bold">R @ViewBag.PaymentSummary.TotalPaid.ToString("N2")</h4>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="p-3 bg-warning bg-opacity-10 rounded-3">
                                    <small class="text-muted">Pending Verification</small>
                                    <h4 class="text-warning mb-0 fw-bold">R @ViewBag.PaymentSummary.PendingVerification.ToString("N2")</h4>
                                </div>
                            </div>
                        </div>
                        <div class="mt-4 text-center">
                            <a href="/Parent/Payments" class="btn btn-outline-primary" style="border-radius: 40px; padding: 8px 24px;">View All Payments</a>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted text-center py-3 mb-0">No payment records yet.</p>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Upcoming Deadlines -->
    <div class="card-modern" data-aos="fade-up">
        <div class="card-header-modern">
            <h5><i class="fas fa-calendar-alt me-2"></i>Upcoming Deadlines</h5>
        </div>
        <div class="card-body p-4">
            <div class="row">
                <div class="col-md-4 mb-2">
                    <i class="fas fa-clock text-warning me-2"></i> Subject Selection: 31 October
                </div>
                <div class="col-md-4 mb-2">
                    <i class="fas fa-credit-card text-warning me-2"></i> Registration Fee: 15 November
                </div>
                <div class="col-md-4 mb-2">
                    <i class="fas fa-check-circle text-success me-2"></i> Term 1 Reports: 15 April
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Footer -->
<footer class="footer">
    <div class="container">
        <div class="text-center">
            <p>&copy; @DateTime.Now.Year PremiumForLearners. All rights reserved.</p>
        </div>
    </div>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
<script>
    AOS.init({ duration: 1000, once: true });
</script>