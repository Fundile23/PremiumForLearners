@model List<PremiumForLearners.Models.Document>

@{
    ViewData["Title"] = "Document Vault";
    var student = ViewBag.Student as PremiumForLearners.Models.Student;
}

<div class="container">
    <div class="row mb-4">
        <div class="col-12">
            <div class="card p-4">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h2>Document Vault</h2>
                        @if (student != null)
                        {
                            <p class="mb-0">@student.FullName - @student.ApplyingGrade</p>
                        }
                    </div>
                    @if (student != null)
                    {
                        <a href="/Parent/UploadDocument/@student.Id" class="btn btn-primary">
                            <i class="fas fa-upload me-2"></i>Upload New Document
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card p-4">
                @if (Model != null && Model.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>Document Type</th>
                                    <th>File Name</th>
                                    <th>Uploaded</th>
                                    <th>Size</th>
                                    <th>Status</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var doc in Model)
                                {
                                    <tr>
                                        <td><strong>@doc.DocumentType</strong></td>
                                        <td>@doc.FileName</td>
                                        <td>@doc.UploadedAt.ToString("dd MMM yyyy")</td>
                                        <td>@((doc.FileSize / 1024).ToString("N0")) KB</td>
                                        <td>
                                            @if (doc.VerificationStatus == "Verified")
                                            {
                                                <span class="badge bg-success">Verified</span>
                                            }
                                            else if (doc.VerificationStatus == "Rejected")
                                            {
                                                <span class="badge bg-danger">Rejected</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning">Pending</span>
                                            }
                                        </td>
                                        <td>
                                            <div class="btn-group">
                                                <a href="/Parent/ViewDocument/@doc.Id" target="_blank" class="btn btn-sm btn-outline-primary">
                                                    <i class="fas fa-eye"></i>
                                                </a>
                                                <form asp-action="DeleteDocument" asp-route-id="@doc.Id" method="post" class="d-inline"
                                                      onsubmit="return confirm('Delete this document?')">
                                                    <input type="hidden" name="studentId" value="@(student?.Id ?? 0)" />
                                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                                        <i class="fas fa-trash"></i>
                                                    </button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center py-5">
                        <i class="fas fa-folder-open fa-3x text-muted mb-3"></i>
                        <p class="text-muted">No documents uploaded yet.</p>
                        @if (student != null)
                        {
                            <a href="/Parent/UploadDocument/@student.Id" class="btn btn-primary">Upload First Document</a>
                        }
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="row mt-3">
        <div class="col-12">
            <a href="/Parent/StudentDetails/@(student?.Id)" class="btn btn-outline-secondary">
                ← Back to Student Details
            </a>
        </div>
    </div>
</div>