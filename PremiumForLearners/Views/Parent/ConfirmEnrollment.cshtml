@model PremiumForLearners.Models.EnrollmentConfirmation
@{
    var student = ViewBag.Student as PremiumForLearners.Models.Student;
    ViewData["Title"] = "Confirm Enrollment";
}

<div class="container" style="max-width: 800px; padding: 40px 0;">
    <div class="card p-4">
        <h2 class="mb-4">Confirm Enrollment</h2>
        
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">@TempData["Success"]</div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">@TempData["Error"]</div>
        }
        
        <div class="alert alert-success mb-4">
            <i class="fas fa-check-circle me-2"></i>
            <strong>Congratulations!</strong> Your child has been accepted to the school.
        </div>

        <div class="bg-light p-3 rounded mb-4">
            <h5>Student Information</h5>
            @if (student != null)
            {
                <p><strong>Name:</strong> @student.FullName</p>
                <p><strong>Grade:</strong> @student.ApplyingGrade</p>
            }
            <p><strong>School:</strong> Assigned School</p>
        </div>

        <form asp-action="ConfirmEnrollment" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="StudentId" />

            <h5 class="mb-3">Medical Information</h5>
            <div class="mb-3">
                <label asp-for="MedicalConditions" class="form-label">Medical Conditions</label>
                <textarea asp-for="MedicalConditions" class="form-control" rows="2" placeholder="Any medical conditions we should know about?"></textarea>
            </div>
            <div class="mb-3">
                <label asp-for="Allergies" class="form-label">Allergies</label>
                <textarea asp-for="Allergies" class="form-control" rows="2" placeholder="Food, medication, or other allergies"></textarea>
            </div>

            <div class="row mb-3">
                <div class="col-md-6">
                    <label asp-for="EmergencyContactName" class="form-label">Emergency Contact Name</label>
                    <input asp-for="EmergencyContactName" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label asp-for="EmergencyContactPhone" class="form-label">Emergency Contact Phone</label>
                    <input asp-for="EmergencyContactPhone" class="form-control" />
                </div>
            </div>

            <div class="mb-3">
                <div class="form-check">
                    <input asp-for="NeedsTransport" class="form-check-input" />
                    <label asp-for="NeedsTransport" class="form-check-label">Needs School Transport</label>
                </div>
                <div id="transportFields" style="display: none;">
                    <label asp-for="TransportRoute" class="form-label mt-2">Preferred Transport Route</label>
                    <input asp-for="TransportRoute" class="form-control" />
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="RegistrationFeePaid" class="form-label">Registration Fee Amount (R)</label>
                <input asp-for="RegistrationFeePaid" class="form-control" type="number" step="0.01" />
                <small class="text-muted">Enter the amount paid for registration</small>
            </div>

            <div class="mb-3">
                <div class="form-check">
                    <input asp-for="TermsAccepted" class="form-check-input" required />
                    <label asp-for="TermsAccepted" class="form-check-label">
                        I confirm that all information provided is true and correct. I accept the school's terms and conditions.
                    </label>
                </div>
            </div>

            <div class="mb-4">
                <label asp-for="DigitalSignature" class="form-label">Digital Signature</label>
                <input asp-for="DigitalSignature" class="form-control" placeholder="Type your full name to sign" required />
                <small class="text-muted">By typing your name, you agree to the terms and confirm enrollment</small>
            </div>

            <div class="d-grid gap-2">
                <button type="submit" class="btn btn-primary btn-lg">Confirm Enrollment</button>
                @if (student != null)
                {
                    <a href="/Parent/StudentDetails/@student.Id" class="btn btn-outline-secondary">Back to Student Details</a>
                }
                else
                {
                    <a href="/Parent/Dashboard" class="btn btn-outline-secondary">Back to Dashboard</a>
                }
            </div>
        </form>
    </div>
</div>

<script>
    var transportCheckbox = document.getElementById('NeedsTransport');
    if (transportCheckbox) {
        transportCheckbox.addEventListener('change', function() {
            var transportFields = document.getElementById('transportFields');
            if (transportFields) {
                transportFields.style.display = this.checked ? 'block' : 'none';
            }
        });
    }
</script>