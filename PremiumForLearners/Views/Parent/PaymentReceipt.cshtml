@model PremiumForLearners.Models.Payment

@{
    ViewData["Title"] = "Payment Receipt";
}

<!-- Bootstrap 5 CSS -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
<!-- Font Awesome 6 -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
<!-- Google Fonts -->
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:wght@400;500;600;700&display=swap" rel="stylesheet">

<style>
    :root {
        --black: #000000;
        --white: #ffffff;
        --gray-lighter: #f5f5f5;
        --gray-text: #6b6b6b;
    }

    body {
        font-family: 'Inter', sans-serif;
        background-color: var(--gray-lighter);
        color: var(--gray-text);
    }

    h1, h2, h3, h4, h5, h6 {
        font-family: 'Playfair Display', serif;
        color: var(--black);
    }

    .receipt-container {
        max-width: 600px;
        margin: 0 auto;
        padding: 40px 20px;
    }

    .receipt-card {
        background: var(--white);
        border-radius: 24px;
        border: 1px solid #e8e8e8;
        overflow: hidden;
        box-shadow: 0 10px 40px rgba(0,0,0,0.08);
    }

    .receipt-header {
        background: linear-gradient(135deg, var(--gray-lighter) 0%, var(--white) 100%);
        padding: 30px;
        text-align: center;
        border-bottom: 1px solid #e8e8e8;
    }

    .receipt-body {
        padding: 30px;
    }

    .receipt-row {
        display: flex;
        justify-content: space-between;
        padding: 12px 0;
        border-bottom: 1px solid #f0f0f0;
    }

    .receipt-label {
        font-weight: 600;
        color: var(--black);
    }

    .receipt-value {
        color: var(--gray-text);
    }

    .amount {
        font-size: 1.8rem;
        font-weight: 800;
        color: var(--black);
    }

    .footer {
        background-color: var(--black);
        color: var(--white);
        padding: 40px 0 30px;
        margin-top: 60px;
    }
</style>

<div class="receipt-container">
    <div class="receipt-card" id="receipt">
        <div class="receipt-header">
            <i class="fas fa-receipt fa-3x" style="color: var(--black);"></i>
            <h2 class="mt-2">Payment Receipt</h2>
            <p class="text-muted mb-0">PremiumForLearners</p>
        </div>

        <div class="receipt-body">
            <div class="receipt-row">
                <span class="receipt-label">Receipt No:</span>
                <span class="receipt-value">@Model.Reference</span>
            </div>
            <div class="receipt-row">
                <span class="receipt-label">Date:</span>
                <span class="receipt-value">@Model.PaymentDate.ToString("dd MMM yyyy")</span>
            </div>
            <div class="receipt-row">
                <span class="receipt-label">Student:</span>
                <span class="receipt-value">@Model.Student?.FullName</span>
            </div>
            <div class="receipt-row">
                <span class="receipt-label">Grade:</span>
                <span class="receipt-value">@Model.Student?.ApplyingGrade</span>
            </div>
            <div class="receipt-row">
                <span class="receipt-label">Payment Type:</span>
                <span class="receipt-value">@Model.PaymentType</span>
            </div>
            <div class="receipt-row">
                <span class="receipt-label">Payment Method:</span>
                <span class="receipt-value">@(Model.PaymentMethod ?? "N/A")</span>
            </div>
            <div class="receipt-row">
                <span class="receipt-label">Status:</span>
                <span class="receipt-value">
                    @if (Model.Status == "Verified")
                    {
                        <span class="badge bg-success">Verified</span>
                    }
                    else if (Model.Status == "Pending")
                    {
                        <span class="badge bg-warning text-dark">Pending</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">@Model.Status</span>
                    }
                </span>
            </div>

            <hr class="my-4">

            <div class="receipt-row" style="border-bottom: none;">
                <span class="receipt-label">Amount Paid:</span>
                <span class="amount">R @Model.Amount.ToString("N2")</span>
            </div>

            @if (!string.IsNullOrEmpty(Model.Notes))
            {
                <div class="mt-4">
                    <strong>Notes:</strong>
                    <p class="mb-0 text-muted">@Model.Notes</p>
                </div>
            }

            <hr class="my-4">

            <div class="text-center mt-4">
                <p class="small text-muted">Thank you for your payment.<br>This is a computer-generated receipt.</p>
            </div>
        </div>
    </div>

    <div class="text-center mt-4">
        <button onclick="window.print()" class="btn" style="background-color: var(--black); color: white; border-radius: 40px; padding: 12px 28px;">
            <i class="fas fa-print me-2"></i>Print Receipt
        </button>
        <a href="/Parent/Payments?studentId=@Model.StudentId" class="btn btn-outline-secondary ms-2" style="border-radius: 40px; padding: 12px 28px;">
            Back to Payments
        </a>
    </div>
</div>

<!-- Footer -->
<footer class="footer">
    <div class="container">
        <div class="text-center">
            <p>&copy; @DateTime.Now.Year PremiumForLearners. All rights reserved.</p>
        </div>
    </div>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>