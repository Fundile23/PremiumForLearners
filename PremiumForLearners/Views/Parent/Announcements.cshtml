@model List<PremiumForLearners.Models.Announcement>

@{
    ViewData["Title"] = "Announcements";
}

<!-- Bootstrap 5 CSS -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
<!-- Font Awesome 6 -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
<!-- Google Fonts -->
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:wght@400;500;600;700&display=swap" rel="stylesheet">
<!-- AOS Animation -->
<link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">

<style>
    :root {
        --black: #000000;
        --white: #ffffff;
        --gray-lighter: #f5f5f5;
        --gray-text: #6b6b6b;
    }

    body {
        font-family: 'Inter', sans-serif;
        background-color: var(--white);
        color: var(--gray-text);
    }

    h1, h2, h3, h4, h5, h6 {
        font-family: 'Playfair Display', serif;
        color: var(--black);
    }

    /* Navigation */
    .navbar {
        background-color: var(--white) !important;
        box-shadow: 0 2px 20px rgba(0,0,0,0.05);
        padding: 15px 0;
        border-bottom: 1px solid #eee;
    }

    .navbar-brand {
        font-family: 'Playfair Display', serif;
        font-weight: 700;
        color: var(--black) !important;
        font-size: 1.8rem;
    }

    .nav-link {
        color: #2c2c2c !important;
        font-weight: 500;
        margin: 0 15px;
    }

    /* Hero Section */
    .hero-section {
        padding: 40px 0 30px;
        background: linear-gradient(135deg, var(--gray-lighter) 0%, var(--white) 100%);
        margin-bottom: 40px;
        border-radius: 24px;
    }

    .hero-badge {
        display: inline-block;
        padding: 4px 12px;
        background: var(--black);
        color: white;
        border-radius: 40px;
        font-size: 0.75rem;
        margin-bottom: 15px;
    }

    .hero-section h1 {
        font-size: 2rem;
        font-weight: 700;
    }

    /* Cards */
    .card-modern {
        background: var(--white);
        border-radius: 24px;
        border: 1px solid #e8e8e8;
        overflow: hidden;
        margin-bottom: 24px;
        transition: all 0.3s ease;
    }

        .card-modern:hover {
            box-shadow: 0 10px 30px rgba(0,0,0,0.05);
        }

    .announcement-card {
        background: var(--white);
        border-radius: 20px;
        border: 1px solid #e8e8e8;
        padding: 24px;
        margin-bottom: 20px;
        transition: all 0.3s ease;
    }

        .announcement-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 30px rgba(0,0,0,0.08);
        }

        .announcement-card.urgent {
            border-left: 4px solid #dc3545;
            background: #fff8f8;
        }

    .announcement-title {
        font-size: 1.25rem;
        font-weight: 700;
        color: var(--black);
        margin-bottom: 8px;
    }

    .announcement-meta {
        font-size: 0.75rem;
        color: var(--gray-text);
        margin-bottom: 16px;
    }

    .announcement-content {
        color: #444;
        line-height: 1.6;
    }

    /* Footer */
    .footer {
        background-color: var(--black);
        color: var(--white);
        padding: 40px 0 30px;
        margin-top: 60px;
    }

        .footer a {
            color: #a0a0a0;
            text-decoration: none;
        }

            .footer a:hover {
                color: var(--white);
            }
</style>

<!-- Navigation -->
<nav class="navbar navbar-expand-lg fixed-top">
    <div class="container">
        <a class="navbar-brand" href="/">PremiumForLearners</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav ms-auto">
                <li class="nav-item"><a class="nav-link" href="/Parent/Dashboard">Dashboard</a></li>
                <li class="nav-item"><a class="nav-link" href="/Parent/Notifications">Notifications</a></li>
                <li class="nav-item"><a class="nav-link" href="/Parent/Announcements">Announcements</a></li>
                <li class="nav-item"><a class="nav-link" href="/Account/Logout">Logout</a></li>
            </ul>
        </div>
    </div>
</nav>

<!-- Hero Section -->
<section class="hero-section">
    <div class="container">
        <div class="hero-content" data-aos="fade-up">
            <div class="hero-badge">Parent Portal</div>
            <h1>Announcements</h1>
            <p class="text-muted">School updates and important notifications</p>
        </div>
    </div>
</section>

<div class="container" style="margin-bottom: 60px;">
    <div class="row">
        <div class="col-12">
            @if (Model.Any())
            {
                <div data-aos="fade-up">
                    @foreach (var announcement in Model)
                    {
                        <div class="announcement-card @(announcement.IsUrgent ? "urgent" : "")">
                            <div class="d-flex justify-content-between align-items-start flex-wrap">
                                <div class="flex-grow-1">
                                    <h3 class="announcement-title">@announcement.Title</h3>
                                    <div class="announcement-meta">
                                        <i class="fas fa-calendar-alt me-1"></i> @announcement.CreatedAt.ToString("dd MMM yyyy, HH:mm")
                                        @if (announcement.IsUrgent)
                                        {
                                            <span class="badge bg-danger ms-2">
                                                <i class="fas fa-exclamation-triangle me-1"></i>URGENT
                                            </span>
                                        }
                                        @if (!string.IsNullOrEmpty(announcement.TargetAudience) && announcement.TargetAudience != "All")
                                        {
                                            <span class="badge bg-secondary ms-2">
                                                <i class="fas fa-users me-1"></i> @announcement.TargetAudience
                                            </span>
                                        }
                                    </div>
                                    <div class="announcement-content">
                                        @Html.Raw(announcement.Content.Replace("\n", "<br />"))
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-5" data-aos="fade-up">
                    <i class="fas fa-bullhorn fa-4x text-muted mb-3"></i>
                    <h4 class="text-muted">No announcements yet</h4>
                    <p class="text-muted">Check back later for important updates from the school.</p>
                </div>
            }

            <!-- Back to Dashboard -->
            <div class="mt-4">
                <a href="/Parent/Dashboard" class="btn btn-outline-primary">
                    <i class="fas fa-arrow-left me-2"></i>Back to Dashboard
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Footer -->
<footer class="footer">
    <div class="container">
        <div class="text-center">
            <p>&copy; @DateTime.Now.Year PremiumForLearners. All rights reserved.</p>
        </div>
    </div>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
<script>
    AOS.init({ duration: 1000, once: true });
</script>