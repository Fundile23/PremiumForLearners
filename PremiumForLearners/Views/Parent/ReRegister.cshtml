@model PremiumForLearners.Models.Student
@{
    var student = ViewBag.Student as PremiumForLearners.Models.Student;
    ViewData["Title"] = "Re-register Student";
}

<div class="container" style="max-width: 600px; padding: 40px 0;">
    <div class="card p-4" data-aos="fade-up">
        <h2 class="mb-4">Re-register Student</h2>

        @if (student != null)
        {
            <div class="alert alert-info mb-4">
                <p><strong>Student:</strong> @student.FullName</p>
                <p><strong>Current Grade:</strong> @student.ApplyingGrade</p>
                <p><strong>Next Grade:</strong> @(int.Parse(student.ApplyingGrade) + 1)</p>
            </div>
        }

        <form asp-action="ReRegister" method="post">
            <input type="hidden" name="studentId" value="@student?.Id" />

            <div class="alert alert-warning mb-4">
                <i class="fas fa-info-circle me-2"></i>
                Please confirm that you want to re-register @student?.FullName for the next academic year.
            </div>

            <div class="mb-4">
                <label class="form-label">Digital Signature</label>
                <input type="text" name="confirmSignature" class="form-control"
                       placeholder="Type your full name to confirm" required />
                <small class="text-muted">By typing your name, you confirm the re-registration.</small>
            </div>

            <div class="d-grid gap-2">
                <button type="submit" class="btn btn-primary" onclick="return confirm('Confirm re-registration for next grade?')">
                    Confirm Re-registration
                </button>
                <a href="/Parent/StudentDetails/@student?.Id" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>