@model PremiumForLearners.Models.SubjectSelection
@{
    var subjects = ViewBag.Subjects as List<PremiumForLearners.Models.Subject>;
    var student = ViewBag.Student as PremiumForLearners.Models.Student;
    ViewData["Title"] = "Select Subjects";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <title>Select Subjects - @(student?.FullName)</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        .subject-card {
            transition: all 0.3s;
            border-left: 3px solid transparent;
        }

            .subject-card:hover {
                background-color: #f8f9fa;
                transform: translateX(5px);
            }

        .core-subject {
            background-color: #e9ecef;
            border-left-color: #0d6efd;
        }

        .elective-subject {
            border-left-color: #198754;
        }

        .category-badge {
            font-size: 0.7rem;
            padding: 2px 8px;
        }
    </style>
</head>
<body>
    <div class="container mt-4 mb-5">
        <div class="card shadow">
            <div class="card-header bg-dark text-white">
                <h4 class="mb-0">📚 Subject Selection for @student?.FullName</h4>
            </div>
            <div class="card-body">
                <!-- Student Info -->
                <div class="alert alert-info">
                    <strong>👤 Student:</strong> @student?.FullName<br>
                    <strong>📖 Grade:</strong> @student?.ApplyingGrade<br>
                    <strong>📅 Academic Year:</strong> @DateTime.Now.Year<br>
                    <strong>⚠️ Note:</strong> You must select <strong>3-4 elective subjects</strong>. Core subjects are mandatory.
                </div>

                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <strong>❌ Error:</strong> @TempData["Error"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }

                @if (subjects == null || !subjects.Any())
                {
                    <div class="alert alert-warning">
                        <strong>⚠️ No subjects available</strong><br>
                        No subjects have been configured for Grade @student?.ApplyingGrade yet. Please contact the school administrator.
                    </div>
                }
                else
                {
                    <form method="post" asp-controller="Parent" asp-action="SubjectSelection" id="subjectForm">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="StudentId" value="@Model.StudentId" />
                        <input type="hidden" name="Grade" value="@Model.Grade" />

                        <!-- Core Subjects Section -->
                        <div class="mb-5">
                            <h5 class="mb-3">📌 Core Subjects (Required)</h5>
                            <div class="border p-3 rounded bg-light">
                                @foreach (var subject in subjects.Where(s => s.IsCore))
                                {
                                    <div class="subject-card core-subject p-2 mb-2 rounded">
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" checked disabled>
                                            <label class="form-check-label fw-bold">
                                                @subject.Name
                                                @if (!string.IsNullOrEmpty(subject.Code))
                                                {
                                                    <span class="text-muted ms-2">(@subject.Code)</span>
                                                }
                                            </label>
                                            @if (!string.IsNullOrEmpty(subject.Description))
                                            {
                                                <br>
                                                <small class="text-muted ms-4">@subject.Description</small>
                                            }
                                            @if (!string.IsNullOrEmpty(subject.Prerequisites))
                                            {
                                                <br>
                                                <small class="text-warning ms-4">📋 Prerequisite: @subject.Prerequisites</small>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- Elective Subjects Section -->
                        <div class="mb-4">
                            <h5 class="mb-3">✨ Elective Subjects (Choose 3-4)</h5>
                            <p class="text-muted small mb-3">Select your preferred elective subjects. You can choose between 3 and 4 subjects.</p>

                            @if (subjects.Where(s => !s.IsCore).Any())
                            {
                                // Group electives by category
                                var electivesByCategory = subjects.Where(s => !s.IsCore).GroupBy(s => s.Category ?? "Other");

                                foreach (var category in electivesByCategory.OrderBy(c => c.Key))
                                {
                                    <div class="mb-4">
                                        <h6 class="text-primary mb-2">📁 @category.Key</h6>
                                        <div class="row">
                                            @foreach (var subject in category.OrderBy(s => s.Name))
                                            {
                                                <div class="col-md-6">
                                                    <div class="subject-card elective-subject p-2 mb-2 rounded border">
                                                        <div class="form-check">
                                                            <input class="form-check-input elective-check"
                                                                   type="checkbox"
                                                                   name="selectedElectives"
                                                                   value="@subject.Name"
                                                                   data-category="@subject.Category"
                                                                   id="elective_@subject.Id">
                                                            <label class="form-check-label fw-bold" for="elective_@subject.Id">
                                                                @subject.Name
                                                                @if (!string.IsNullOrEmpty(subject.Code))
                                                                {
                                                                    <span class="text-muted ms-2">(@subject.Code)</span>
                                                                }
                                                                @if (subject.Credits > 0)
                                                                {
                                                                    <span class="badge bg-secondary category-badge ms-2">@subject.Credits credits</span>
                                                                }
                                                            </label>
                                                            @if (!string.IsNullOrEmpty(subject.Description))
                                                            {
                                                                <br>
                                                                <small class="text-muted ms-4">@subject.Description</small>
                                                            }
                                                            @if (!string.IsNullOrEmpty(subject.Prerequisites))
                                                            {
                                                                <br>
                                                                <small class="text-warning ms-4">📋 Prerequisite: @subject.Prerequisites</small>
                                                            }
                                                        </div>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="alert alert-info">
                                    No elective subjects available for this grade.
                                </div>
                            }
                        </div>

                        <!-- Selection Counter -->
                        <div class="alert alert-secondary" id="selectionCounter">
                            <strong>Selected electives: <span id="selectedCount">0</span></strong>
                            <span id="selectionMessage" class="ms-3"></span>
                        </div>

                        <!-- Buttons -->
                        <div class="mt-4">
                            <button type="submit" class="btn btn-dark btn-lg" id="submitBtn" disabled>
                                <i class="fas fa-check-circle"></i> Submit Selection
                            </button>
                            <a href="/Parent/StudentDetails/@Model.StudentId" class="btn btn-outline-secondary btn-lg ms-2">
                                <i class="fas fa-times"></i> Cancel
                            </a>
                        </div>
                    </form>
                }
            </div>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const checkboxes = document.querySelectorAll('.elective-check');
            const submitBtn = document.getElementById('submitBtn');
            const selectedCountSpan = document.getElementById('selectedCount');
            const selectionMessageSpan = document.getElementById('selectionMessage');

            function updateSelection() {
                const checked = document.querySelectorAll('.elective-check:checked');
                const checkedCount = checked.length;

                // Update counter display
                selectedCountSpan.textContent = checkedCount;

                if (checkedCount >= 3 && checkedCount <= 4) {
                    submitBtn.disabled = false;
                    selectionMessageSpan.innerHTML = '✅ Perfect! You can submit your selection.';
                    selectionMessageSpan.style.color = 'green';
                    document.getElementById('selectionCounter').className = 'alert alert-success';
                } else {
                    submitBtn.disabled = true;
                    if (checkedCount < 3) {
                        const moreNeeded = 3 - checkedCount;
                        selectionMessageSpan.innerHTML = `⚠️ Need ${moreNeeded} more subject${moreNeeded > 1 ? 's' : ''}. Please select at least 3 subjects.`;
                        selectionMessageSpan.style.color = 'red';
                    } else if (checkedCount > 4) {
                        selectionMessageSpan.innerHTML = '⚠️ Too many subjects selected. Maximum is 4. Please unselect some.';
                        selectionMessageSpan.style.color = 'red';
                    }
                    document.getElementById('selectionCounter').className = 'alert alert-warning';
                }

                // Optional: Show warning if selecting subjects from same category
                const categories = {};
                checked.forEach(cb => {
                    const category = cb.getAttribute('data-category');
                    if (category) {
                        categories[category] = (categories[category] || 0) + 1;
                    }
                });

                let warning = '';
                for (const [cat, count] of Object.entries(categories)) {
                    if (count > 2) {
                        warning += `⚠️ You selected ${count} subjects from ${cat}. Consider diversifying your choices. `;
                    }
                }
                if (warning) {
                    const warningDiv = document.createElement('div');
                    warningDiv.className = 'alert alert-warning mt-2 small';
                    warningDiv.innerHTML = warning;
                    const existingWarning = document.getElementById('categoryWarning');
                    if (existingWarning) existingWarning.remove();
                    warningDiv.id = 'categoryWarning';
                    document.getElementById('selectionCounter').after(warningDiv);
                } else {
                    const existingWarning = document.getElementById('categoryWarning');
                    if (existingWarning) existingWarning.remove();
                }
            }

            checkboxes.forEach(cb => cb.addEventListener('change', updateSelection));
            updateSelection();
        });
    </script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>