@model PremiumForLearners.Models.Student

@{
    ViewData["Title"] = "Add Child";
}

<!-- Bootstrap 5 CSS -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
<!-- Font Awesome 6 -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
<!-- Google Fonts -->
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:wght@400;500;600;700&display=swap" rel="stylesheet">
<!-- AOS Animation -->
<link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">

<style>
    :root {
        --black: #000000;
        --white: #ffffff;
        --gray-lighter: #f5f5f5;
        --gray-text: #6b6b6b;
    }

    body {
        font-family: 'Inter', sans-serif;
        background-color: var(--white);
        color: var(--gray-text);
    }

    h1, h2, h3, h4, h5, h6 {
        font-family: 'Playfair Display', serif;
        color: var(--black);
    }

    /* Navigation */
    .navbar {
        background-color: var(--white) !important;
        box-shadow: 0 2px 20px rgba(0,0,0,0.05);
        padding: 15px 0;
        border-bottom: 1px solid #eee;
    }

    .navbar-brand {
        font-family: 'Playfair Display', serif;
        font-weight: 700;
        color: var(--black) !important;
        font-size: 1.8rem;
    }

    .nav-link {
        color: #2c2c2c !important;
        font-weight: 500;
        margin: 0 15px;
    }

    /* Hero Section */
    .hero-section {
        padding: 40px 0 30px;
        background: linear-gradient(135deg, var(--gray-lighter) 0%, var(--white) 100%);
        margin-bottom: 40px;
        border-radius: 24px;
    }

    .hero-badge {
        display: inline-block;
        padding: 4px 12px;
        background: var(--black);
        color: white;
        border-radius: 40px;
        font-size: 0.75rem;
        margin-bottom: 15px;
    }

    .hero-section h1 {
        font-size: 2rem;
        font-weight: 700;
    }

    /* Card */
    .card-modern {
        background: var(--white);
        border-radius: 24px;
        border: 1px solid #e8e8e8;
        overflow: hidden;
        transition: all 0.3s ease;
    }

        .card-modern:hover {
            box-shadow: 0 10px 30px rgba(0,0,0,0.05);
        }

    .card-header-modern {
        background: var(--gray-lighter);
        padding: 20px 24px;
        border-bottom: 1px solid #e0e0e0;
    }

        .card-header-modern h5 {
            margin: 0;
            font-size: 1.1rem;
            font-weight: 600;
        }

    /* Form Controls */
    .form-control, .form-select {
        border-radius: 12px;
        border: 1px solid #e0e0e0;
        padding: 12px 16px;
        font-size: 0.9rem;
        transition: all 0.3s ease;
    }

        .form-control:focus, .form-select:focus {
            border-color: var(--black);
            box-shadow: 0 0 0 3px rgba(0,0,0,0.1);
        }

    .form-label {
        font-weight: 600;
        color: var(--black);
        margin-bottom: 8px;
    }

    /* Buttons */
    .btn-primary {
        background-color: var(--black);
        border: none;
        border-radius: 40px;
        padding: 12px 28px;
        font-weight: 600;
        transition: all 0.3s ease;
    }

        .btn-primary:hover {
            background-color: #333;
            transform: translateY(-2px);
        }

    .btn-outline-primary {
        border-radius: 40px;
        padding: 12px 28px;
        font-weight: 600;
        border-color: var(--black);
        color: var(--black);
    }

        .btn-outline-primary:hover {
            background-color: var(--black);
            color: white;
            transform: translateY(-2px);
        }

    /* Footer */
    .footer {
        background-color: var(--black);
        color: var(--white);
        padding: 40px 0 30px;
        margin-top: 60px;
    }

        .footer a {
            color: #a0a0a0;
            text-decoration: none;
        }

            .footer a:hover {
                color: var(--white);
            }
</style>

<!-- Navigation -->
<nav class="navbar navbar-expand-lg fixed-top">
    <div class="container">
        <a class="navbar-brand" href="/">PremiumForLearners</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav ms-auto">
                <li class="nav-item"><a class="nav-link" href="/Parent/Dashboard">Dashboard</a></li>
                <li class="nav-item"><a class="nav-link" href="/Parent/Notifications">Notifications</a></li>
                <li class="nav-item"><a class="nav-link" href="/Parent/Announcements">Announcements</a></li>
                <li class="nav-item"><a class="nav-link" href="/Account/Logout">Logout</a></li>
            </ul>
        </div>
    </div>
</nav>

<!-- Hero Section -->
<section class="hero-section">
    <div class="container">
        <div class="hero-content" data-aos="fade-up">
            <div class="hero-badge">Parent Portal</div>
            <h1>Add Child/Student</h1>
            <p class="text-muted">Register a new child for enrollment</p>
        </div>
    </div>
</section>

<div class="container" style="margin-bottom: 60px;">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card-modern" data-aos="fade-up">
                <div class="card-header-modern">
                    <h5><i class="fas fa-user-plus me-2"></i>Student Registration Form</h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="AddStudent" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <div class="mb-3">
                            <label asp-for="FullName" class="form-label">
                                <i class="fas fa-user me-1"></i> @Html.DisplayNameFor(m => m.FullName)
                            </label>
                            <input asp-for="FullName" class="form-control" placeholder="Enter full name" />
                            <span asp-validation-for="FullName" class="text-danger"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="DateOfBirth" class="form-label">
                                    <i class="fas fa-calendar-alt me-1"></i> @Html.DisplayNameFor(m => m.DateOfBirth)
                                </label>
                                <input asp-for="DateOfBirth" class="form-control" type="date" />
                                <span asp-validation-for="DateOfBirth" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="BirthCertificateNumber" class="form-label">
                                    <i class="fas fa-id-card me-1"></i> @Html.DisplayNameFor(m => m.BirthCertificateNumber)
                                </label>
                                <input asp-for="BirthCertificateNumber" class="form-control" placeholder="e.g., 20050101" />
                                <span asp-validation-for="BirthCertificateNumber" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="HomeLanguage" class="form-label">
                                    <i class="fas fa-language me-1"></i> @Html.DisplayNameFor(m => m.HomeLanguage)
                                </label>
                                <select asp-for="HomeLanguage" class="form-select">
                                    <option>English</option>
                                    <option>Afrikaans</option>
                                    <option>isiZulu</option>
                                    <option>isiXhosa</option>
                                    <option>Sesotho</option>
                                    <option>Setswana</option>
                                    <option>Sepedi</option>
                                    <option>Xitsonga</option>
                                    <option>SiSwati</option>
                                    <option>Tshivenda</option>
                                    <option>isiNdebele</option>
                                </select>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Citizenship" class="form-label">
                                    <i class="fas fa-passport me-1"></i> @Html.DisplayNameFor(m => m.Citizenship)
                                </label>
                                <input asp-for="Citizenship" class="form-control" />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="PreviousSchool" class="form-label">
                                <i class="fas fa-school me-1"></i> @Html.DisplayNameFor(m => m.PreviousSchool)
                            </label>
                            <input asp-for="PreviousSchool" class="form-control" placeholder="Leave blank if none" />
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="ApplyingGrade" class="form-label">
                                    <i class="fas fa-graduation-cap me-1"></i> @Html.DisplayNameFor(m => m.ApplyingGrade)
                                </label>
                                <select asp-for="ApplyingGrade" class="form-select">
                                    <option value="">Select Grade</option>
                                    <option value="R">Grade R</option>
                                    <option value="1">Grade 1</option>
                                    <option value="2">Grade 2</option>
                                    <option value="3">Grade 3</option>
                                    <option value="4">Grade 4</option>
                                    <option value="5">Grade 5</option>
                                    <option value="6">Grade 6</option>
                                    <option value="7">Grade 7</option>
                                    <option value="8">Grade 8</option>
                                    <option value="9">Grade 9</option>
                                    <option value="10">Grade 10</option>
                                    <option value="11">Grade 11</option>
                                    <option value="12">Grade 12</option>
                                </select>
                                <span asp-validation-for="ApplyingGrade" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="SpecialNeeds" class="form-label">
                                    <i class="fas fa-notes-medical me-1"></i> @Html.DisplayNameFor(m => m.SpecialNeeds)
                                </label>
                                <input asp-for="SpecialNeeds" class="form-control" placeholder="Any medical conditions or special needs?" />
                            </div>
                        </div>

                        <hr class="my-4">

                        <div class="d-flex gap-3">
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-save me-2"></i>Save Child
                            </button>
                            <a href="/Parent/Dashboard" class="btn btn-outline-primary">
                                <i class="fas fa-times me-2"></i>Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Footer -->
<footer class="footer">
    <div class="container">
        <div class="text-center">
            <p>&copy; @DateTime.Now.Year PremiumForLearners. All rights reserved.</p>
        </div>
    </div>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
<script>
    AOS.init({ duration: 1000, once: true });
</script>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}