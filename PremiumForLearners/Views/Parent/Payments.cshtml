@model List<PremiumForLearners.Models.Payment>
@{
    var student = ViewBag.Student as PremiumForLearners.Models.Student;
    var feeStructure = ViewBag.FeeStructure as List<PremiumForLearners.Models.FeeStructure>;
    ViewData["Title"] = "Payments";
}

<!-- Bootstrap 5 CSS -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
<!-- Font Awesome 6 -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
<!-- Google Fonts -->
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:wght@400;500;600;700&display=swap" rel="stylesheet">
<!-- AOS Animation -->
<link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">

<style>
    :root {
        --black: #000000;
        --white: #ffffff;
        --gray-lighter: #f5f5f5;
        --gray-text: #6b6b6b;
    }

    body {
        font-family: 'Inter', sans-serif;
        background-color: var(--white);
        color: var(--gray-text);
    }

    h1, h2, h3, h4, h5, h6 {
        font-family: 'Playfair Display', serif;
        color: var(--black);
    }

    .navbar {
        background-color: var(--white) !important;
        box-shadow: 0 2px 20px rgba(0,0,0,0.05);
        padding: 15px 0;
        border-bottom: 1px solid #eee;
    }

    .navbar-brand {
        font-family: 'Playfair Display', serif;
        font-weight: 700;
        color: var(--black) !important;
        font-size: 1.8rem;
    }

    .nav-link {
        color: #2c2c2c !important;
        font-weight: 500;
        margin: 0 15px;
    }

    .payments-hero {
        padding: 40px 0 30px;
        background: linear-gradient(135deg, var(--gray-lighter) 0%, var(--white) 100%);
        margin-bottom: 40px;
        border-radius: 24px;
    }

    .payments-badge {
        display: inline-block;
        padding: 4px 12px;
        background: var(--black);
        color: white;
        border-radius: 40px;
        font-size: 0.75rem;
        margin-bottom: 15px;
    }

    .card-modern {
        background: var(--white);
        border-radius: 24px;
        border: 1px solid #e8e8e8;
        overflow: hidden;
        margin-bottom: 24px;
        transition: all 0.3s ease;
    }

        .card-modern:hover {
            box-shadow: 0 10px 30px rgba(0,0,0,0.05);
        }

    .card-header-modern {
        background: var(--gray-lighter);
        padding: 20px 24px;
        border-bottom: 1px solid #e0e0e0;
    }

        .card-header-modern h5 {
            margin: 0;
            font-size: 1.1rem;
            font-weight: 600;
        }

    .table-custom {
        margin: 0;
    }

        .table-custom th {
            background: var(--white);
            color: var(--black);
            font-weight: 600;
            border-bottom: 1px solid #e8e8e8;
            padding: 15px 20px;
        }

        .table-custom td {
            padding: 15px 20px;
            vertical-align: middle;
            border-bottom: 1px solid #f0f0f0;
        }

        .table-custom tr:hover {
            background: var(--gray-lighter);
        }

    .footer {
        background-color: var(--black);
        color: var(--white);
        padding: 40px 0 30px;
        margin-top: 60px;
    }
</style>

<!-- Navigation -->
<nav class="navbar navbar-expand-lg fixed-top">
    <div class="container">
        <a class="navbar-brand" href="/">PremiumForLearners</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav ms-auto">
                <li class="nav-item"><a class="nav-link" href="/Parent/Dashboard">Dashboard</a></li>
                <li class="nav-item"><a class="nav-link" href="/Parent/Notifications">Notifications</a></li>
                <li class="nav-item"><a class="nav-link" href="/Parent/Announcements">Announcements</a></li>
                <li class="nav-item"><a class="nav-link" href="/Account/Logout">Logout</a></li>
            </ul>
        </div>
    </div>
</nav>

<!-- Hero Section -->
<section class="payments-hero">
    <div class="container">
        <div class="payments-hero-content" data-aos="fade-up">
            <div class="payments-badge">Parent Portal</div>
            <h1>Payment History</h1>
            @if (student != null)
            {
                <p class="text-muted">@student.FullName - Grade @student.ApplyingGrade</p>
            }
            else
            {
                <p class="text-muted">Manage your payments and view receipts</p>
            }
        </div>
    </div>
</section>

<div class="container" style="margin-bottom: 60px;">
    <!-- Make Payment Button -->
    <div class="text-end mb-4" data-aos="fade-up">
        @if (student != null)
        {
            <a href="/Parent/MakePayment/@student.Id" class="btn" style="background-color: var(--black); color: white; border-radius: 40px; padding: 10px 28px;">
                <i class="fas fa-credit-card me-2"></i>Make Payment
            </a>
        }
        else
        {
            <a href="/Parent/MakePayment/0" class="btn" style="background-color: var(--black); color: white; border-radius: 40px; padding: 10px 28px;">
                <i class="fas fa-credit-card me-2"></i>Make Payment
            </a>
        }
    </div>

    <!-- Fee Structure Summary -->
    @if (feeStructure != null && feeStructure.Any())
    {
        <div class="card-modern" data-aos="fade-up">
            <div class="card-header-modern">
                <h5><i class="fas fa-chart-line me-2"></i>Fee Structure</h5>
            </div>
            <div class="table-responsive">
                <table class="table table-custom">
                    <thead>
                        <tr>
                            <th>Fee Type</th>
                            <th>Grade</th>
                            <th>Amount</th>
                            <th>Frequency</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var fee in feeStructure)
                        {
                            <tr>
                                <td>@fee.FeeType</td>
                                <td>@fee.Grade</td>
                                <td class="fw-bold text-success">R @fee.Amount.ToString("N2")</td>
                                <td>@(fee.PaymentFrequency ?? "One-time")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <!-- Payment History -->
    <div class="card-modern" data-aos="fade-up">
        <div class="card-header-modern">
            <h5><i class="fas fa-history me-2"></i>Payment History</h5>
        </div>
        <div class="table-responsive">
            @if (Model.Any())
            {
                <table class="table table-custom">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Student</th>
                            <th>Payment Type</th>
                            <th>Amount</th>
                            <th>Reference</th>
                            <th>Status</th>
                            <th>Receipt</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var payment in Model)
                        {
                            <tr>
                                <td>@payment.PaymentDate.ToString("dd MMM yyyy")</td>
                                <td class="fw-semibold">@payment.Student?.FullName</td>
                                <td>@payment.PaymentType</td>
                                <td class="fw-bold text-success">R @payment.Amount.ToString("N2")</td>
                                <td><small class="text-muted">@payment.Reference</small></td>
                                <td>
                                    @if (payment.Status == "Completed")
                                    {
                                        <span class="badge bg-success" style="border-radius: 40px; padding: 5px 12px;">Completed</span>
                                    }
                                    else if (payment.Status == "Verified")
                                    {
                                        <span class="badge bg-success" style="border-radius: 40px; padding: 5px 12px;">Verified</span>
                                    }
                                    else if (payment.Status == "Pending")
                                    {
                                        <span class="badge bg-warning text-dark" style="border-radius: 40px; padding: 5px 12px;">Pending</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger" style="border-radius: 40px; padding: 5px 12px;">@payment.Status</span>
                                    }
                                </td>
                                <td>
                                    <a href="/Parent/PaymentReceipt/@payment.Id" class="btn btn-sm btn-outline-primary" style="border-radius: 20px;">
                                        <i class="fas fa-receipt me-1"></i>Receipt
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="fas fa-credit-card fa-4x text-muted mb-3"></i>
                    <h5 class="text-muted">No payment records found</h5>
                    <p class="text-muted">Make your first payment to get started.</p>
                </div>
            }
        </div>
    </div>

    <!-- Back Button -->
    <div class="mt-4">
        <a href="/Parent/Dashboard" class="btn btn-outline-secondary" style="border-radius: 40px; padding: 10px 24px;">
            <i class="fas fa-arrow-left me-2"></i>Back to Dashboard
        </a>
    </div>
</div>

<!-- Footer -->
<footer class="footer">
    <div class="container">
        <div class="text-center">
            <p>&copy; @DateTime.Now.Year PremiumForLearners. All rights reserved.</p>
        </div>
    </div>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
<script>
    AOS.init({ duration: 1000, once: true });
</script>